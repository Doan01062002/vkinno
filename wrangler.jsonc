{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vkinno-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/quan-tri/*", "/files/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vkinno-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "vkinno-files" }],
  // "0 19 * * *" = 02:00 giờ VN: việc hằng ngày; "*/15 * * * *": đối soát đơn + đẩy tồn Pancake.
  "triggers": { "crons": ["0 19 * * *", "*/15 * * * *"] },
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vkinno-db-staging",
          "database_id": "31dfb07f-2f06-46e9-b402-39f4dfc1d0e9",
          "migrations_dir": "migrations"
        }
      ],
      // Tạm chưa bật R2 trên tài khoản Cloudflare: staging chạy không R2 (upload ảnh + sao lưu tắt).
      // Bật R2 xong thì khôi phục: [{ "binding": "FILES", "bucket_name": "vkinno-files-staging" }]
      "r2_buckets": []
    }
  }
}
