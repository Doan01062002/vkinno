{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "@cloudflare/workers-types",
      "node"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "worker/**/*.ts",
    "test/**/*.ts",
    "src/shared/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "test/ui/**"
  ]
}
