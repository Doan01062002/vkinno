---
import { products } from "../data/products";
import { SITE_CONFIG } from "../data/siteConfig";

const navItems = [
  { name: "Trang chủ", href: "/" },
  { name: "Cửa hàng", href: "/san-pham" },
  { name: "Sỉ Gara & Solar", href: "/giai-phap-gara" },
  { name: "Bossman KOC", href: "/bossman-creator" },
  { name: "Cẩm nang", href: "/cam-nang" },
  { name: "Giới thiệu", href: "/gioi-thieu" },
  { name: "Liên hệ", href: "/lien-he" },
];

const currentPath = Astro.url.pathname;
const searchList = products.map((p) => ({
  name: p.name,
  slug: p.slug,
  sku: p.sku,
  price: p.price_vnd,
  image: p.image_url,
  category: p.category_name,
  brand: p.brand || "VKINNO",
}));
---

<header class="w-full bg-white shadow-sm border-b border-slate-200 sticky top-0 z-[100] font-inter" id="site-header">
  <!-- Top Trust Bar -->
  <div class="bg-[#0F1638] text-white text-xs py-1.5 px-3 sm:px-8 flex justify-between items-center font-display font-semibold">
    <div class="flex items-center gap-2 min-w-0 pr-2 overflow-hidden">
      <span class="inline-block w-2 h-2 rounded-full bg-[#FF8A15] shrink-0"></span>
      <span class="truncate text-[11px] sm:text-xs tracking-wide">
        FREESHIP TOÀN QUỐC ĐƠN TỪ 199.000Đ • HOTLINE KHO: {SITE_CONFIG.hotlinePrimary}
      </span>
    </div>
    <div class="flex items-center space-x-3 text-xs text-slate-200 shrink-0">
      <a
        aria-label="Trang Facebook chính thức VKINNO"
        class="hover:text-[#FF8A15] transition-colors py-0.5"
        href={SITE_CONFIG.facebookUrl}
        rel="noopener noreferrer"
        target="_blank"
        title="Facebook VKINNO"
      >
        <i class="fa-brands fa-facebook-f" aria-hidden="true"></i>
      </a>
      <a
        aria-label="Gian hàng Shopee chính hãng VKINNO"
        class="hover:text-[#FF8A15] transition-colors py-0.5"
        href={SITE_CONFIG.shopeeUrl}
        rel="noopener noreferrer"
        target="_blank"
        title="Shopee VKINNO"
      >
        <i class="fa-solid fa-store" aria-hidden="true"></i>
      </a>
      <a
        aria-label={`Gọi Hotline ${SITE_CONFIG.hotlinePrimary}`}
        class="hover:text-[#FF8A15] transition-colors py-0.5 hidden sm:inline-flex items-center gap-1 font-bold"
        href={`tel:${SITE_CONFIG.hotlinePrimaryTel}`}
      >
        <i class="fa-solid fa-phone text-[11px]" aria-hidden="true"></i>
        <span class="tabular-nums">{SITE_CONFIG.hotlinePrimary}</span>
      </a>
    </div>
  </div>

  <!-- Main Header Row -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-2.5 flex items-center justify-between gap-3 sm:gap-4 bg-white">
    <button
      aria-label="Mở danh mục điều hướng"
      class="lg:hidden text-slate-800 hover:text-[#1E2B6B] transition-colors cursor-pointer w-11 h-11 flex items-center justify-center rounded-xl hover:bg-slate-100 shrink-0"
      id="mobile-menu-trigger"
      type="button"
    >
      <i class="fa-solid fa-bars text-xl" aria-hidden="true"></i>
    </button>

    <a class="flex items-center space-x-3 shrink-0" href="/" aria-label="Trang chủ VKINNO">
      <img
        alt="Logo VKINNO Công nghệ Vĩnh Khang"
        class="h-8 sm:h-9 w-auto object-contain"
        src="/logo.png"
        width="132"
        height="36"
      />
      <div class="hidden sm:flex flex-col text-[11px] leading-tight font-display uppercase font-bold border-l border-slate-300 pl-2.5">
        <span class="text-[#1E2B6B] font-extrabold">Công Nghệ</span>
        <span class="text-[#A84B00] font-extrabold">Làm Sạch Sinh Học</span>
      </div>
    </a>

    <!-- Desktop Search -->
    <div class="hidden md:flex flex-1 max-w-md mx-6 relative">
      <div class="relative w-full">
        <form action="/san-pham" method="GET" data-du-an="chu-dong-vkinno" class="relative w-full" id="desktop-search-form" role="search">
          <input
            autocomplete="off"
            aria-label="Tìm kiếm sản phẩm VKINNO"
            class="w-full pl-4 pr-11 py-2 bg-slate-50 border border-[#64748B] rounded-full text-sm focus:bg-white transition-all text-slate-900 font-medium placeholder-slate-500"
            id="search-input"
            name="search"
            placeholder="Tìm Bossman, tẩy dầu mỡ, Solar Shield..."
            type="text"
          />
          <button
            aria-label="Thực hiện tìm kiếm"
            class="absolute right-1.5 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full text-slate-700 hover:text-[#1E2B6B] flex items-center justify-center cursor-pointer"
            type="submit"
            id="search-button"
          >
            <i class="fa-solid fa-magnifying-glass text-sm" aria-hidden="true"></i>
          </button>
        </form>
        <div
          class="absolute left-0 right-0 mt-2 bg-white border border-slate-200 rounded-2xl shadow-2xl p-2.5 hidden flex-col z-50 space-y-1.5 max-h-80 overflow-y-auto"
          id="search-suggestions-dropdown"
        ></div>
      </div>
    </div>

    <!-- Action Icons (>= 44px touch targets) -->
    <div class="flex items-center space-x-2 sm:space-x-3">
      <button
        aria-label="Mở thanh tìm kiếm"
        class="md:hidden bg-[#1E2B6B] hover:bg-[#151E4B] text-white w-11 h-11 rounded-xl flex items-center justify-center shadow-sm transition-colors cursor-pointer"
        id="mobile-search-toggle"
        type="button"
      >
        <i class="fa-solid fa-magnifying-glass text-sm" aria-hidden="true"></i>
      </button>

      <a
        aria-label="Tra cứu đơn hàng"
        title="Tra cứu đơn hàng"
        class="bg-[#F3F6FC] hover:bg-[#E8ECF8] text-[#1E2B6B] border border-slate-200 px-3 h-11 rounded-xl flex items-center justify-center gap-2 font-display font-bold text-xs transition-colors"
        href="/tai-khoan"
      >
        <i class="fa-solid fa-truck-fast text-sm" aria-hidden="true"></i>
        <span class="hidden xl:inline">Tra cứu đơn</span>
      </a>

      <button
        aria-label="Mở giỏ hàng"
        type="button"
        id="header-cart-trigger"
        class="relative bg-[#1E2B6B] hover:bg-[#151E4B] text-white px-3.5 h-11 rounded-xl flex items-center justify-center gap-2 shadow-sm transition-colors cursor-pointer"
      >
        <i class="fa-solid fa-basket-shopping text-sm" aria-hidden="true"></i>
        <span class="hidden sm:inline text-xs font-display font-bold">Giỏ hàng</span>
        <span
          class="hidden absolute -top-1.5 -right-1.5 bg-[#FF8A15] text-[#0F1638] text-[11px] font-extrabold rounded-full min-w-[20px] h-5 px-1 items-center justify-center border border-white tabular-nums"
          id="cart-badge-count"
        >
          0
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Search Panel -->
  <div class="hidden md:hidden w-full bg-white border-t border-slate-200 px-4 py-3" id="mobile-search-bar-panel">
    <div class="relative w-full">
      <form action="/san-pham" method="GET" data-du-an="chu-dong-vkinno" class="relative w-full" id="mobile-search-form" role="search">
        <input
          autocomplete="off"
          aria-label="Nhập tên sản phẩm cần tìm"
          class="w-full pl-4 pr-11 py-2.5 bg-slate-50 border border-[#64748B] rounded-xl text-base text-slate-900 font-medium placeholder-slate-500"
          id="mobile-header-search-input"
          name="search"
          placeholder="Tìm sản phẩm VKINNO..."
          type="text"
        />
        <button
          aria-label="Tìm kiếm"
          class="absolute right-2 top-1/2 -translate-y-1/2 w-9 h-9 text-slate-700 flex items-center justify-center cursor-pointer"
          type="submit"
          id="mobile-header-search-submit"
        >
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        </button>
      </form>
      <div
        class="absolute left-0 right-0 mt-1.5 bg-white border border-slate-200 rounded-xl shadow-xl p-2 hidden flex-col z-50 space-y-1.5 max-h-60 overflow-y-auto"
        id="mobile-header-search-suggestions"
      ></div>
    </div>
  </div>

  <!-- Desktop Navigation Bar -->
  <nav class="hidden lg:block bg-[#1E2B6B] border-t border-white/10" aria-label="Điều hướng chính">
    <div class="max-w-7xl mx-auto px-8 flex items-center justify-between min-h-[42px]">
      <div class="relative group" id="category-dropdown-wrapper">
        <button
          type="button"
          class="flex items-center space-x-2 text-white hover:bg-white/10 font-display font-bold uppercase transition-all py-2 px-3 rounded-lg cursor-pointer text-xs tracking-wide"
          id="category-dropdown-btn"
        >
          <i class="fa-solid fa-layer-group text-[#FF8A15]" aria-hidden="true"></i>
          <span>Danh mục 9 sản phẩm</span>
          <i class="fa-solid fa-chevron-down text-[10px] ml-1 transition-transform group-hover:rotate-180" aria-hidden="true"></i>
        </button>

        <div
          class="absolute left-0 top-full pt-1 w-[560px] hidden group-hover:block z-50"
          id="mega-menu-dropdown"
        >
          <div class="bg-white border border-slate-200 rounded-2xl shadow-2xl p-5 grid grid-cols-3 gap-5 text-slate-800">
            <div>
              <a
                class="block font-display font-bold text-[#1E2B6B] border-b border-slate-200 pb-2 mb-2 text-xs uppercase hover:text-[#A84B00]"
                href="/san-pham?category=1"
              >
                Tẩy Rửa Gia Đình &amp; Solar
              </a>
              <p class="text-xs text-slate-600 leading-relaxed">
                Combo Nhà tắm &amp; Bếp 145k, Bossman canxi, Tẩy dầu mỡ không xút, ClearWay &amp; Solar Shield 5L.
              </p>
            </div>
            <div>
              <a
                class="block font-display font-bold text-[#1E2B6B] border-b border-slate-200 pb-2 mb-2 text-xs uppercase hover:text-[#A84B00]"
                href="/san-pham?category=3"
              >
                Chăm Sóc Kính Ô Tô
              </a>
              <p class="text-xs text-slate-600 leading-relaxed">
                Tẩy ố kính lái VisionX 500ml &amp; Nước rửa kính ClearWay Auto can 5L không Methanol.
              </p>
            </div>
            <div>
              <a
                class="block font-display font-bold text-[#1E2B6B] border-b border-slate-200 pb-2 mb-2 text-xs uppercase hover:text-[#A84B00]"
                href="/san-pham?category=2"
              >
                Bình Xịt Chiết Rót
              </a>
              <p class="text-xs text-slate-600 leading-relaxed">
                Bình xịt nhựa PET dày 500ml đầu phun sương có khóa an toàn (19.000đ).
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="flex items-center space-x-5 text-xs font-display font-bold tracking-wide uppercase text-white py-1">
        {navItems.map((item) => {
          const isActive =
            currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`transition-colors py-1.5 px-1 ${
                isActive
                  ? "text-[#FF8A15] border-b-2 border-[#FF8A15]"
                  : "text-white/95 hover:text-[#FF8A15]"
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </div>
    </div>
  </nav>

  <!-- Mobile Slide Drawer -->
  <div
    class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-[200] hidden opacity-0 transition-opacity duration-250"
    id="mobile-menu-drawer"
  >
    <div
      class="w-80 max-w-[86vw] h-full bg-white p-5 shadow-2xl flex flex-col justify-between transform -translate-x-full transition-transform duration-250 overflow-y-auto"
      id="mobile-menu-content"
    >
      <div>
        <div class="flex items-center justify-between pb-4 border-b border-slate-200">
          <a class="flex items-center" href="/" aria-label="Trang chủ VKINNO">
            <img alt="VKINNO Logo" class="h-8 w-auto object-contain" src="/logo.png" width="118" height="32" />
          </a>
          <button
            aria-label="Đóng menu"
            class="text-slate-600 hover:text-slate-900 w-11 h-11 flex items-center justify-center rounded-xl hover:bg-slate-100 cursor-pointer"
            id="mobile-menu-close"
            type="button"
          >
            <i class="fa-solid fa-xmark text-xl" aria-hidden="true"></i>
          </button>
        </div>

        <nav class="py-4 space-y-1 font-display font-bold text-sm" aria-label="Menu di động">
          {navItems.map((item) => (
            <a
              class="flex items-center justify-between py-3 px-3 rounded-xl text-slate-800 hover:bg-slate-100 transition-colors"
              href={item.href}
            >
              <span>{item.name}</span>
              <i class="fa-solid fa-chevron-right text-xs text-slate-400" aria-hidden="true"></i>
            </a>
          ))}
          <a
            class="flex items-center justify-between py-3 px-3 rounded-xl text-[#1E2B6B] bg-[#F3F6FC] font-extrabold mt-2"
            href="/tai-khoan"
          >
            <span>Tra cứu đơn hàng VKxxxx</span>
            <i class="fa-solid fa-magnifying-glass text-xs" aria-hidden="true"></i>
          </a>
        </nav>
      </div>

      <div class="pt-4 border-t border-slate-200 space-y-2.5 text-xs">
        <a
          href={`tel:${SITE_CONFIG.hotlinePrimaryTel}`}
          class="w-full min-h-[46px] rounded-xl bg-[#1E2B6B] text-white font-display font-bold flex items-center justify-center gap-2"
        >
          <i class="fa-solid fa-phone" aria-hidden="true"></i>
          <span>Gọi Kho: {SITE_CONFIG.hotlinePrimary}</span>
        </a>
        <a
          href={SITE_CONFIG.zaloUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full min-h-[46px] rounded-xl bg-[#0052CC] text-white font-display font-bold flex items-center justify-center gap-2"
        >
          <i class="fa-solid fa-comment-dots" aria-hidden="true"></i>
          <span>Nhắn Zalo Kỹ Thuật VKINNO</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Bottom Navigation Bar (Hidden on product detail & checkout where sticky CTA bar takes over) -->
  <div
    id="mobile-bottom-nav"
    class="fixed bottom-0 left-0 right-0 h-16 bg-white border-t border-slate-200 shadow-[0_-4px_14px_rgba(15,22,56,0.08)] lg:hidden flex items-center justify-around z-[140] px-1 font-inter"
  >
    <a
      class={`flex flex-col items-center justify-center min-w-[64px] h-12 rounded-xl px-2 ${
        currentPath === "/" ? "text-[#1E2B6B] font-extrabold" : "text-slate-600"
      }`}
      href="/"
    >
      <i class="fa-solid fa-house text-base" aria-hidden="true"></i>
      <span class="text-[11px] font-semibold mt-0.5">Trang chủ</span>
    </a>
    <a
      class={`flex flex-col items-center justify-center min-w-[64px] h-12 rounded-xl px-2 ${
        currentPath.startsWith("/san-pham") ? "text-[#1E2B6B] font-extrabold" : "text-slate-600"
      }`}
      href="/san-pham"
    >
      <i class="fa-solid fa-store text-base" aria-hidden="true"></i>
      <span class="text-[11px] font-semibold mt-0.5">Cửa hàng</span>
    </a>
    <a
      class={`relative flex flex-col items-center justify-center min-w-[64px] h-12 rounded-xl px-2 ${
        currentPath.startsWith("/gio-hang") ? "text-[#1E2B6B] font-extrabold" : "text-slate-600"
      }`}
      href="/gio-hang"
    >
      <i class="fa-solid fa-basket-shopping text-base" aria-hidden="true"></i>
      <span class="text-[11px] font-semibold mt-0.5">Giỏ hàng</span>
      <span
        class="hidden absolute top-0.5 right-2.5 bg-[#FF8A15] text-[#0F1638] text-[10px] font-extrabold rounded-full min-w-[18px] h-[18px] px-1 items-center justify-center border border-white tabular-nums"
        id="bottom-cart-badge-count"
      >
        0
      </span>
    </a>
    <a
      class={`flex flex-col items-center justify-center min-w-[64px] h-12 rounded-xl px-2 ${
        currentPath.startsWith("/tai-khoan") ? "text-[#1E2B6B] font-extrabold" : "text-slate-600"
      }`}
      href="/tai-khoan"
    >
      <i class="fa-solid fa-receipt text-base" aria-hidden="true"></i>
      <span class="text-[11px] font-semibold mt-0.5">Tra đơn</span>
    </a>
  </div>
</header>

<script is:inline define:vars={{ searchList }}>
  const searchToggle = document.getElementById("mobile-search-toggle");
  const searchPanel = document.getElementById("mobile-search-bar-panel");
  searchToggle?.addEventListener("click", () => {
    searchPanel?.classList.toggle("hidden");
  });

  const menuTrigger = document.getElementById("mobile-menu-trigger");
  const menuDrawer = document.getElementById("mobile-menu-drawer");
  const menuContent = document.getElementById("mobile-menu-content");
  const menuClose = document.getElementById("mobile-menu-close");

  function openMobileMenu() {
    if (!menuDrawer || !menuContent) return;
    menuDrawer.classList.remove("hidden");
    requestAnimationFrame(() => {
      menuDrawer.classList.remove("opacity-0");
      menuContent.classList.remove("-translate-x-full");
    });
    document.body.style.overflow = "hidden";
  }

  function closeMobileMenu() {
    if (!menuDrawer || !menuContent) return;
    menuDrawer.classList.add("opacity-0");
    menuContent.classList.add("-translate-x-full");
    setTimeout(() => {
      menuDrawer.classList.add("hidden");
      document.body.style.overflow = "";
    }, 250);
  }

  menuTrigger?.addEventListener("click", openMobileMenu);
  menuClose?.addEventListener("click", closeMobileMenu);
  menuDrawer?.addEventListener("click", (e) => {
    if (e.target === menuDrawer) closeMobileMenu();
  });

  document.getElementById("header-cart-trigger")?.addEventListener("click", () => {
    if (typeof window.vkinnoOpenCartDrawer === "function") {
      window.vkinnoOpenCartDrawer();
    } else {
      window.location.href = "/gio-hang";
    }
  });

  const formatVND = (num) => Number(num || 0).toLocaleString("vi-VN") + " ₫";

  function setupAutocomplete(inputId, dropdownId) {
    const input = document.getElementById(inputId);
    const dropdown = document.getElementById(dropdownId);
    if (!input || !dropdown) return;

    input.addEventListener("input", () => {
      const query = input.value.trim().toLowerCase();
      if (!query) {
        dropdown.classList.add("hidden");
        dropdown.classList.remove("flex");
        dropdown.innerHTML = "";
        return;
      }

      const matches = searchList
        .filter(
          (item) =>
            item.name.toLowerCase().includes(query) ||
            item.sku.toLowerCase().includes(query) ||
            item.category.toLowerCase().includes(query)
        )
        .slice(0, 5);

      if (matches.length === 0) {
        dropdown.innerHTML = `
          <div class="p-3 text-center text-xs text-slate-500 font-medium">
            Không tìm thấy sản phẩm phù hợp.
          </div>
        `;
      } else {
        dropdown.innerHTML =
          matches
            .map(
              (item) => `
          <a href="/san-pham/${item.slug}" class="flex items-center space-x-3 p-2 rounded-xl hover:bg-slate-50 transition-colors text-slate-800 group">
            <img src="${item.image}" alt="${item.name}" width="44" height="44" class="w-11 h-11 object-cover rounded-lg border border-slate-200 shrink-0" />
            <div class="flex-1 min-w-0">
              <p class="text-xs font-bold text-slate-900 line-clamp-1 group-hover:text-[#1E2B6B]">${item.name}</p>
              <p class="text-xs font-extrabold text-[#C81E1E] tabular-nums">${formatVND(item.price)}</p>
            </div>
          </a>
        `
            )
            .join("") +
          `
          <a href="/san-pham?search=${encodeURIComponent(query)}" class="block text-center text-xs font-bold text-[#1E2B6B] hover:underline py-2 border-t border-slate-100">
            Xem tất cả kết quả →
          </a>
        `;
      }

      dropdown.classList.remove("hidden");
      dropdown.classList.add("flex");
    });

    document.addEventListener("click", (e) => {
      if (!input.contains(e.target) && !dropdown.contains(e.target)) {
        dropdown.classList.add("hidden");
        dropdown.classList.remove("flex");
      }
    });
  }

  setupAutocomplete("search-input", "search-suggestions-dropdown");
  setupAutocomplete("mobile-header-search-input", "mobile-header-search-suggestions");
</script>
