---
import Layout from "../layouts/Layout.astro";
import { SITE_CONFIG } from "../data/siteConfig";
---

<Layout
  title="Chương Trình KOC & Tiếp Thị Liên Kết Bossman - VKINNO Chính Hãng"
  description="Đăng ký nhận mẫu trải nghiệm thực tế và hợp tác tiếp thị liên kết minh bạch dòng sản phẩm tẩy cặn canxi Bossman & tẩy dầu mỡ VKINNO tuân thủ Luật Quảng cáo 75/2025/QH15."
>
  <div class="w-full min-h-screen bg-[#F8FAFC] pb-16 font-inter">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-[#0F1638] via-[#1E2B6B] to-[#151E4B] text-white py-14 sm:py-20 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-5">
        <nav class="flex items-center gap-2 text-xs text-slate-300 font-semibold" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#FF8A15]">Trang chủ</a>
          <span>/</span>
          <span class="text-white font-bold">Hợp tác KOC &amp; Affiliate</span>
        </nav>

        <div class="max-w-3xl space-y-4">
          <div class="inline-flex flex-wrap items-center gap-2">
            <span class="px-3 py-1 rounded-full bg-[#FF8A15] text-[#0F1638] text-xs font-extrabold uppercase">
              VKINNO Creator Program
            </span>
            <span class="px-3 py-1 rounded-full bg-white/10 border border-white/20 text-slate-100 text-xs font-semibold">
              Minh bạch #TiepThiLienKet · Luật Quảng cáo 75/2025/QH15
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold font-montserrat leading-tight">
            ĐỒNG HÀNH CÙNG BOSSMAN &amp; VKINNO REVIEW THẬT TẠI NHÀ
          </h1>
          <p class="text-sm sm:text-base text-slate-200 leading-relaxed">
            Dành cho các nhà sáng tạo nội dung Mẹo dọn nhà, Chăm sóc gia đình và Chăm xe trên TikTok, Shopee Video, Facebook Reels: nhận bộ sản phẩm trải nghiệm thực tế từ kho Vĩnh Khang và hoa hồng tiếp thị liên kết minh bạch.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href="#dang-ky-koc"
              data-cta="koc-register-hero"
              class="min-h-[48px] px-6 py-3.5 rounded-xl bg-[#FF8A15] hover:bg-[#E57600] text-[#0F1638] font-extrabold text-xs sm:text-sm uppercase tracking-wider inline-flex items-center justify-center shadow-md"
            >
              Đăng Ký Nhận Bộ Mẫu Trải Nghiệm →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits & Law 75/2025 Content Guidelines -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 py-12 sm:py-16 space-y-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-2xl border border-[#E2E8F0] shadow-xs space-y-2.5">
          <div class="w-12 h-12 rounded-xl bg-[#FFF7ED] text-[#A84B00] flex items-center justify-center text-xl">
            <i class="fa-solid fa-box-open"></i>
          </div>
          <h2 class="text-base font-extrabold text-[#0F172A] font-montserrat uppercase">1. Tặng Mẫu Thật Trải Nghiệm</h2>
          <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">
            Gửi miễn phí Combo Đôi Nhà Sạch (Bossman Tẩy cặn canxi 500ml + Tẩy dầu mỡ bếp 500ml) hoặc VisionX Clean tới tận nhà để KOC tự tay thử nghiệm trên vết bẩn thật trước khi lên video.
          </p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-[#E2E8F0] shadow-xs space-y-2.5">
          <div class="w-12 h-12 rounded-xl bg-[#ECFDF5] text-[#047857] flex items-center justify-center text-xl">
            <i class="fa-solid fa-percent"></i>
          </div>
          <h2 class="text-base font-extrabold text-[#0F172A] font-montserrat uppercase">2. Hoa Hồng Liên Kết Cao</h2>
          <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">
            Hoa hồng Affiliate trực tiếp trên giỏ hàng Shopee chính hãng Vĩnh Khang và TikTok Shop từ 12% – 18%, sản phẩm giá dễ chốt (69.000 ₫ – 199.000 ₫) có tỷ lệ mua lặp lại cao.
          </p>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-[#E2E8F0] shadow-xs space-y-2.5">
          <div class="w-12 h-12 rounded-xl bg-[#EEF2FF] text-[#1E2B6B] flex items-center justify-center text-xl">
            <i class="fa-solid fa-scale-balanced"></i>
          </div>
          <h2 class="text-base font-extrabold text-[#0F172A] font-montserrat uppercase">3. Pháp Lý Bảo Vệ Kênh</h2>
          <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">
            Cung cấp đầy đủ giấy tờ pháp nhân TNHH Vĩnh Khang, hóa đơn VAT và bộ từ khóa chuẩn Luật Quảng cáo 75/2025/QH15 giúp video không bị bóp tương tác hay vi phạm chính sách sàn.
          </p>
        </div>
      </div>

      <!-- Mandatory Creator Transparency Checklist (Điều 15a Luật Quảng cáo 75/2025/QH15) -->
      <div class="bg-[#FFFBEB] border border-[#FDE68A] rounded-2xl p-6 sm:p-8 space-y-4">
        <div class="flex items-center gap-2.5 text-[#92400E]">
          <i class="fa-solid fa-circle-check text-xl"></i>
          <h2 class="text-base sm:text-lg font-extrabold uppercase font-montserrat">
            Quy chuẩn nội dung bắt buộc cho KOC hợp tác cùng VKINNO (Luật Quảng cáo 75/2025/QH15)
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm text-[#78350F] leading-relaxed">
          <div class="bg-white p-4 rounded-xl border border-[#FDE68A] space-y-1.5">
            <strong class="block text-[#047857] uppercase">✓ Nội dung chuẩn kỹ thuật cần nêu rõ:</strong>
            <ul class="list-disc pl-5 space-y-1">
              <li>Trải nghiệm thực tế sản phẩm: xịt phủ đều và <strong>làm mềm, bóc tách cặn khoáng sau 5–15 phút ủ</strong> trước khi lau bằng mút mềm và dội sạch nước.</li>
              <li>Nhắc rõ bề mặt không dùng (đá tự nhiên Marble/Terrazzo, vòi mạ đã bong tróc cơ học).</li>
              <li>Gắn nhãn minh bạch <strong>#QuangCao</strong> hoặc <strong>#TiepThiLienKet</strong> ở đầu mô tả hoặc tính năng Liên kết trả phí của nền tảng.</li>
            </ul>
          </div>
          <div class="bg-white p-4 rounded-xl border border-[#FECACA] space-y-1.5 text-[#7F1D1D]">
            <strong class="block text-[#C81E1E] uppercase">✕ Các cụm từ cấm dùng trong video/bài viết:</strong>
            <ul class="list-disc pl-5 space-y-1">
              <li>Không nói quá sự thật như <em>"làm sạch tức thì trong 30 giây không cần chờ"</em> hay <em>"sạch vĩnh viễn 100% trọn đời"</em>.</li>
              <li>Không dùng từ so sánh nhất thiếu kiểm chứng: <em>"số 1 Việt Nam"</em>, <em>"tốt nhất thị trường"</em>, <em>"an toàn tuyệt đối uống được"</em>.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- KOC Registration Form -->
      <div id="dang-ky-koc" class="max-w-3xl mx-auto bg-white rounded-3xl border border-[#E2E8F0] shadow-sm p-6 sm:p-10 space-y-6">
        <div class="text-center space-y-1.5">
          <h2 class="text-xl sm:text-2xl font-extrabold text-[#0F172A] font-montserrat uppercase">
            ĐĂNG KÝ NHẬN MẪU THỬ KOC &amp; AFFILIATE
          </h2>
          <p class="text-xs sm:text-sm text-[#475569]">
            Kho Vĩnh Khang xét duyệt và gửi bộ mẫu miễn phí trong 24–48 giờ làm việc.
          </p>
        </div>

        <form id="koc-lead-form" data-du-an="chu-dong-vkinno" class="space-y-4">
          <input type="hidden" name="du_an" value="chu-dong-vkinno" />
          <div class="hidden" aria-hidden="true">
            <label for="koc-hp-trap">Website</label>
            <input type="text" id="koc-hp-trap" name="website_url_trap" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label for="koc-name" class="block text-xs font-extrabold text-[#334155] uppercase">Họ tên / Nghệ danh KOC *</label>
              <input
                type="text"
                id="koc-name"
                name="contact_name"
                required
                placeholder="Nhập họ tên người nhận mẫu"
                class="w-full text-base p-3 rounded-xl border border-[#CBD5E1] bg-[#F8FAFC] focus:bg-white focus:outline-none focus:border-[#1E2B6B] text-[#0F172A]"
              />
            </div>
            <div class="space-y-1">
              <label for="koc-phone" class="block text-xs font-extrabold text-[#334155] uppercase">Số điện thoại / Zalo *</label>
              <input
                type="tel"
                id="koc-phone"
                name="phone"
                required
                placeholder="VD: 0938791389"
                class="w-full text-base p-3 rounded-xl border border-[#CBD5E1] bg-[#F8FAFC] focus:bg-white focus:outline-none focus:border-[#1E2B6B] text-[#0F172A] tabular-nums"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label for="koc-channel" class="block text-xs font-extrabold text-[#334155] uppercase">Link kênh TikTok / Shopee Video / FB *</label>
              <input
                type="text"
                id="koc-channel"
                name="channel_url"
                required
                placeholder="https://www.tiktok.com/@tenkenh..."
                class="w-full text-base p-3 rounded-xl border border-[#CBD5E1] bg-[#F8FAFC] focus:bg-white focus:outline-none focus:border-[#1E2B6B] text-[#0F172A]"
              />
            </div>
            <div class="space-y-1">
              <label for="koc-followers" class="block text-xs font-extrabold text-[#334155] uppercase">Lượng người theo dõi (Followers)</label>
              <input
                type="text"
                id="koc-followers"
                name="follower_count"
                placeholder="VD: 5.000 followers"
                class="w-full text-base p-3 rounded-xl border border-[#CBD5E1] bg-[#F8FAFC] focus:bg-white focus:outline-none focus:border-[#1E2B6B] text-[#0F172A]"
              />
            </div>
          </div>

          <div class="space-y-1">
            <label for="koc-address" class="block text-xs font-extrabold text-[#334155] uppercase">Địa chỉ nhận bộ mẫu thử &amp; Sản phẩm muốn review *</label>
            <textarea
              id="koc-address"
              name="message"
              required
              rows="3"
              placeholder="Ghi địa chỉ nhận hàng + Bộ sản phẩm bạn muốn quay (Combo Đôi Nhà Sạch hoặc Bộ Chăm Xe VisionX)..."
              class="w-full text-base p-3 rounded-xl border border-[#CBD5E1] bg-[#F8FAFC] focus:bg-white focus:outline-none focus:border-[#1E2B6B] text-[#0F172A]"
            ></textarea>
          </div>

          <!-- Unchecked-by-default Consent Checkbox (Luật BVDLCN 91/2025/QH15) -->
          <label for="koc-privacy-consent" class="flex items-start gap-3 p-3.5 rounded-xl bg-[#F8FAFC] border border-[#CBD5E1] cursor-pointer">
            <input
              type="checkbox"
              id="koc-privacy-consent"
              name="privacy_consent"
              required
              class="mt-1 w-5 h-5 rounded accent-[#1E2B6B] shrink-0 cursor-pointer"
            />
            <span class="text-xs text-[#334155] leading-relaxed">
              Tôi đồng ý cung cấp thông tin liên hệ và địa chỉ để <strong>{SITE_CONFIG.legalName}</strong> xét duyệt gửi sản phẩm mẫu KOC theo{" "}
              <a href="/chinh-sach/chinh-sach-bao-mat" target="_blank" class="font-bold text-[#1E2B6B] underline">Chính sách bảo vệ dữ liệu cá nhân (Luật 91/2025/QH15)</a> và cam kết gắn nhãn minh bạch #TiepThiLienKet khi đăng nội dung. *
            </span>
          </label>

          <div id="koc-form-error" class="hidden p-3 rounded-xl bg-[#FEF2F2] border border-[#FECACA] text-xs font-bold text-[#991B1B]"></div>

          <button
            type="submit"
            id="btn-koc-submit"
            data-cta="koc-submit"
            class="w-full min-h-[50px] bg-[#FF8A15] hover:bg-[#E57600] text-[#0F1638] font-extrabold text-xs sm:text-sm uppercase tracking-wider rounded-xl py-3.5 px-6 shadow-sm cursor-pointer transition-colors font-montserrat"
          >
            ĐĂNG KÝ NHẬN MẪU THỬ MIỄN PHÍ →
          </button>
        </form>

        <div id="koc-success-box" class="hidden p-5 rounded-2xl bg-[#ECFDF5] border border-[#10B981] text-center space-y-2">
          <p class="font-extrabold text-base text-[#047857]">✓ Đăng ký KOC thành công!</p>
          <p class="text-xs sm:text-sm text-[#334155]">
            Hồ sơ kênh của bạn đã được lưu vào bảng Quản trị KOC tại kho VKINNO. Chúng tôi sẽ liên hệ qua Zalo để xác nhận gửi mẫu!
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  const form = document.getElementById("koc-lead-form") as HTMLFormElement | null;
  const errBox = document.getElementById("koc-form-error");
  const succBox = document.getElementById("koc-success-box");
  const submitBtn = document.getElementById("btn-koc-submit") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errBox?.classList.add("hidden");

    const consent = document.getElementById("koc-privacy-consent") as HTMLInputElement | null;
    if (!consent?.checked) {
      if (errBox) {
        errBox.textContent = "Vui lòng tích đồng ý xử lý dữ liệu nhận mẫu theo Luật BVDLCN 91/2025/QH15.";
        errBox.classList.remove("hidden");
      }
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "ĐANG GỬI ĐĂNG KÝ...";
    }

    try {
      const res = await fetch("/api/leads", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          du_an: "chu-dong-vkinno",
          privacy_consent: true,
          website_url_trap: (document.getElementById("koc-hp-trap") as HTMLInputElement)?.value || "",
          lead_type: "KOC",
          contact_name: (document.getElementById("koc-name") as HTMLInputElement)?.value.trim(),
          phone: (document.getElementById("koc-phone") as HTMLInputElement)?.value.trim(),
          channel_url: (document.getElementById("koc-channel") as HTMLInputElement)?.value.trim(),
          follower_count: (document.getElementById("koc-followers") as HTMLInputElement)?.value.trim(),
          message: (document.getElementById("koc-address") as HTMLTextAreaElement)?.value.trim(),
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data.error || "Không thể gửi đăng ký lúc này.");

      form.classList.add("hidden");
      succBox?.classList.remove("hidden");
    } catch (err: any) {
      if (errBox) {
        errBox.innerHTML = `${err.message || "Lỗi kết nối mạng."} Bạn có thể gửi link kênh trực tiếp qua <a href="https://zalo.me/0938791389" target="_blank" class="underline font-extrabold">Zalo Kho VKINNO 0938.791.389</a>.`;
        errBox.classList.remove("hidden");
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "ĐĂNG KÝ NHẬN MẪU THỬ MIỄN PHÍ →";
      }
    }
  });
</script>
