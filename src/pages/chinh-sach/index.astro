---
import Layout from "../../layouts/Layout.astro";
import policiesData from "../../data/policies.json";

const defaultSlug = "so-huu-dieu-khoan";
const initialPolicy = policiesData[defaultSlug as keyof typeof policiesData];
---

<Layout
  title="Chính Sách & Điều Khoản - VKINNO"
  description="Các chính sách, cam kết chính thức từ Công ty TNHH Công nghệ Vĩnh Khang nhằm bảo vệ tối đa quyền lợi khách hàng."
>
  <!-- Hero Banner -->
  <section class="w-full bg-[#1E2B6B] text-white py-12 sm:py-16 font-inter">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-4">
      <nav class="flex items-center space-x-2 text-xs font-semibold text-slate-300">
        <a href="/" class="hover:text-[#FF8A15] transition-colors">Trang chủ</a>
        <span>/</span>
        <span class="text-white">Chính sách</span>
      </nav>

      <div class="space-y-3 max-w-3xl">
        <span id="policy-badge" class="inline-block bg-[#FF8A15] text-slate-950 text-[10px] font-black tracking-widest uppercase px-3 py-1 rounded-full shadow-[0_0_12px_rgba(255,138,21,0.3)] font-montserrat">
          {initialPolicy.badge}
        </span>
        <h1 id="policy-header-title" class="text-2xl sm:text-4xl font-black uppercase tracking-wider font-montserrat" set:html={initialPolicy.heroTitle || initialPolicy.title}>
        </h1>
        <p class="text-xs sm:text-sm text-slate-300 font-medium leading-relaxed">
          Các chính sách, cam kết chính thức từ Công ty TNHH Công nghệ Vĩnh Khang nhằm bảo vệ tối đa quyền lợi khách hàng.
        </p>
      </div>
    </div>
  </section>

  <!-- Policy Body Container -->
  <section class="max-w-7xl mx-auto px-4 sm:px-8 py-10 sm:py-14 font-inter">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Mobile Quick Policy Selector (Horizontal Scrollable Pills) -->
      <div class="lg:hidden col-span-12 w-full overflow-x-auto pb-2 flex gap-2 scrollbar-none" id="mobile-policy-pills-bar">
        {Object.entries(policiesData).map(([slug, item]: [string, any], idx) => {
          const isActive = idx === 0;
          return (
            <a
              href={`#${slug}`}
              data-slug={slug}
              class={`mobile-policy-pill shrink-0 flex items-center space-x-2 px-3.5 py-2 rounded-full text-xs font-bold transition-all border ${
                isActive
                  ? "bg-[#1E2B6B] text-white border-[#1E2B6B] shadow-sm"
                  : "bg-white text-slate-700 border-slate-200 hover:border-slate-300"
              }`}
            >
              <i class={`fa-solid ${item.icon} text-xs ${isActive ? "text-[#FF8A15]" : "text-slate-400"} pill-icon`}></i>
              <span class="whitespace-nowrap">{item.title}</span>
            </a>
          );
        })}
      </div>

      <!-- Left Sidebar Navigation (Desktop) -->
      <aside class="hidden lg:block lg:col-span-4 lg:sticky lg:top-24 h-fit space-y-3 bg-white p-6 rounded-2xl shadow-sm border border-slate-100">
        <h3 class="text-xs font-black text-slate-400 uppercase tracking-wider mb-2 px-2 font-montserrat">
          Danh mục chính sách
        </h3>
        <nav class="flex flex-col space-y-1" id="policy-nav-list">
          {Object.entries(policiesData).map(([slug, item]: [string, any], idx) => {
            const isActive = idx === 0;
            return (
              <a
                href={`#${slug}`}
                data-slug={slug}
                class={`policy-nav-item flex items-center space-x-3 px-4 py-3 rounded-xl text-xs sm:text-sm font-bold transition-all ${
                  isActive
                    ? "bg-[#1E2B6B] text-white shadow-md shadow-[#1E2B6B]/20 translate-x-1"
                    : "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
                }`}
              >
                <i class={`fa-solid ${item.icon} ${isActive ? "text-[#FF8A15]" : "text-slate-400"} text-base w-5 policy-icon`}></i>
                <span>{item.title}</span>
              </a>
            );
          })}
        </nav>
      </aside>

      <!-- Right Policy Content -->
      <article class="lg:col-span-8 bg-white p-6 sm:p-10 rounded-3xl shadow-sm border border-slate-100 min-h-[500px]">
        <div class="flex items-center space-x-3 pb-6 border-b border-slate-100 mb-6">
          <div id="policy-content-icon-wrap" class="w-10 h-10 rounded-xl bg-[#FFF7ED] text-[#FF8A15] flex items-center justify-center text-lg">
            <i id="policy-content-icon" class={`fa-solid ${initialPolicy.icon}`}></i>
          </div>
          <h2 id="policy-content-title" class="text-xl sm:text-2xl font-black text-slate-900 font-montserrat tracking-tight">
            {initialPolicy.title}
          </h2>
        </div>

        <div id="policy-body-content" class="prose max-w-none text-slate-600 text-xs sm:text-sm leading-relaxed" set:html={initialPolicy.content}>
        </div>
      </article>

    </div>
  </section>

  <!-- Client-side tab switcher for hashes -->
  <script is:inline define:vars={{ policiesData }}>
    function updatePolicyFromHash() {
      let rawHash = window.location.hash.replace(/^#/, "").trim();
      if (!rawHash) return;

      // Match rawHash or find matching policy key
      const policyKeys = Object.keys(policiesData);
      let targetKey = policyKeys.find(k => k === rawHash);
      if (!targetKey) {
        // Try fuzzy or partial matching
        targetKey = policyKeys.find(k => rawHash.includes(k) || k.includes(rawHash));
      }

      if (!targetKey || !policiesData[targetKey]) return;

      const p = policiesData[targetKey];

      // Update Header & Badge
      const badgeEl = document.getElementById("policy-badge");
      if (badgeEl) badgeEl.textContent = p.badge;

      const headerTitleEl = document.getElementById("policy-header-title");
      if (headerTitleEl) headerTitleEl.innerHTML = p.heroTitle || p.title;

      const contentTitleEl = document.getElementById("policy-content-title");
      if (contentTitleEl) contentTitleEl.textContent = p.title;

      const iconEl = document.getElementById("policy-content-icon");
      if (iconEl) iconEl.className = `fa-solid ${p.icon}`;

      const bodyEl = document.getElementById("policy-body-content");
      if (bodyEl) bodyEl.innerHTML = p.content;

      // Update Desktop Nav active classes
      document.querySelectorAll(".policy-nav-item").forEach(item => {
        const itemSlug = item.getAttribute("data-slug");
        const icon = item.querySelector(".policy-icon");
        if (itemSlug === targetKey) {
          item.className = "policy-nav-item flex items-center space-x-3 px-4 py-3 rounded-xl text-xs sm:text-sm font-bold transition-all bg-[#1E2B6B] text-white shadow-md shadow-[#1E2B6B]/20 translate-x-1";
          if (icon) {
            icon.classList.remove("text-slate-400");
            icon.classList.add("text-[#FF8A15]");
          }
        } else {
          item.className = "policy-nav-item flex items-center space-x-3 px-4 py-3 rounded-xl text-xs sm:text-sm font-bold transition-all text-slate-600 hover:bg-slate-50 hover:text-slate-900";
          if (icon) {
            icon.classList.remove("text-[#FF8A15]");
            icon.classList.add("text-slate-400");
          }
        }
      });

      // Update Mobile Pills active classes
      document.querySelectorAll(".mobile-policy-pill").forEach(pill => {
        const itemSlug = pill.getAttribute("data-slug");
        const icon = pill.querySelector(".pill-icon");
        if (itemSlug === targetKey) {
          pill.className = "mobile-policy-pill shrink-0 flex items-center space-x-2 px-3.5 py-2 rounded-full text-xs font-bold transition-all border bg-[#1E2B6B] text-white border-[#1E2B6B] shadow-sm";
          if (icon) {
            icon.classList.remove("text-slate-400");
            icon.classList.add("text-[#FF8A15]");
          }
          try {
            pill.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
          } catch {}
        } else {
          pill.className = "mobile-policy-pill shrink-0 flex items-center space-x-2 px-3.5 py-2 rounded-full text-xs font-bold transition-all border bg-white text-slate-700 border-slate-200 hover:border-slate-300";
          if (icon) {
            icon.classList.remove("text-[#FF8A15]");
            icon.classList.add("text-slate-400");
          }
        }
      });

      // Scroll to content container smoothly if mobile
      if (window.innerWidth < 1024) {
        const article = document.querySelector("article");
        if (article) article.scrollIntoView({ behavior: "smooth" });
      }
    }

    window.addEventListener("hashchange", updatePolicyFromHash);
    document.addEventListener("DOMContentLoaded", updatePolicyFromHash);
    // Also run immediately if DOM is ready
    if (document.readyState === "complete" || document.readyState === "interactive") {
      updatePolicyFromHash();
    }
  </script>
</Layout>
