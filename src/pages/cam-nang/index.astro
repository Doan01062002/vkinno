---
import Layout from "../../layouts/Layout.astro";
import postsData from "../../data/posts.json";
---

<Layout
  title="Cẩm Nang Kỹ Thuật Tẩy Rửa & Chăm Sóc Xe - VKINNO"
  description="Hướng dẫn thời gian ủ hóa chất 5–15 phút, cách xử lý cặn canxi nhà tắm, dầu mỡ bếp từ và vệ sinh tấm pin mặt trời đúng chuẩn từ VKINNO."
>
  <div class="w-full min-h-screen bg-[#F8FAFC] py-10 font-inter">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-10">
      <nav class="flex items-center space-x-2 text-xs font-semibold text-[#475569]" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#1E2B6B] transition-colors">Trang chủ</a>
        <span>/</span>
        <span class="text-[#0F172A] font-bold">Cẩm nang VKINNO</span>
      </nav>

      <div class="flex flex-col items-center text-center space-y-2">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0F172A] tracking-wider uppercase font-montserrat">
          CẨM NANG KỸ THUẬT VKINNO
        </h1>
        <div class="w-16 h-1 bg-[#FF8A15] rounded"></div>
        <p class="text-xs sm:text-sm text-[#475569] font-medium max-w-lg">
          Kinh nghiệm nhận diện bề mặt vật liệu, tỷ lệ pha loãng can 5L và thời gian ủ hoạt chất an toàn tại nhà
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {postsData.map((post) => (
          <div class="group bg-white rounded-2xl overflow-hidden shadow-xs border border-[#E2E8F0] hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
            <a href={`/cam-nang/${post.slug}`} class="block">
              <div class="w-full aspect-[16/10] overflow-hidden bg-[#F1F5F9] relative">
                <img
                  src={post.image_url}
                  alt={post.title}
                  width="600"
                  height="375"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <div class="p-6 space-y-3">
                <div class="flex items-center space-x-2 text-[11px] font-bold text-[#475569] uppercase tracking-wider">
                  <span class="text-[#9A3412] bg-[#FFF7ED] px-2.5 py-0.5 rounded-full font-extrabold">Hướng dẫn</span>
                  <span>•</span>
                  <span>{new Date(post.created_at).toLocaleDateString("vi-VN", { day: "2-digit", month: "2-digit", year: "numeric" })}</span>
                </div>
                <h2 class="font-montserrat font-extrabold text-[#0F172A] text-sm sm:text-base leading-snug line-clamp-2 group-hover:text-[#1E2B6B] transition-colors">
                  {post.title}
                </h2>
                <p class="text-xs text-[#475569] line-clamp-3 leading-relaxed font-medium">
                  {post.summary}
                </p>
              </div>
            </a>
            <div class="px-6 pb-6 pt-3 border-t border-[#F1F5F9]">
              <a
                href={`/cam-nang/${post.slug}`}
                class="inline-flex items-center space-x-2 text-xs font-extrabold text-[#1E2B6B] hover:text-[#A84B00] transition-colors font-montserrat uppercase"
              >
                <span>Đọc bài viết</span>
                <i class="fa-solid fa-arrow-right text-[10px]"></i>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
