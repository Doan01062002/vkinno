---
import Layout from "../layouts/Layout.astro";
import { products } from "../data/products";
import { SITE_CONFIG } from "../data/siteConfig";

const productLookup = Object.fromEntries(
  products.map((p) => [p.name, { image: p.image_url, slug: p.slug, sku: p.sku, price: p.price_vnd }])
);
const freeshipThreshold = SITE_CONFIG.freeshipThresholdVnd;
const defaultShipping = SITE_CONFIG.defaultShippingFeeVnd;
---

<Layout
  title="Giỏ Hàng Của Bạn - VKINNO"
  description="Xem sản phẩm, nhận ưu đãi miễn phí vận chuyển đơn từ 199.000đ và áp mã KHACHCU10 tại giỏ hàng VKINNO."
  hideFloatingZaloOnMobile={true}
>
  <div class="w-full min-h-screen bg-[#F8FAFC] py-8 font-inter">
    <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-6">
      <!-- Breadcrumbs -->
      <nav class="text-xs text-[#475569] font-semibold flex items-center space-x-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#1E2B6B] transition-colors">Trang chủ</a>
        <span>/</span>
        <span class="text-[#0F172A] font-bold">Giỏ hàng</span>
      </nav>

      <h1 class="text-xl sm:text-2xl font-extrabold text-[#0F172A] tracking-wider uppercase font-montserrat">
        GIỎ HÀNG CỦA BẠN
      </h1>

      <!-- Dynamic Freeship Progress & 1-Tap Upsell Banner -->
      <div id="freeship-progress-card" class="bg-white rounded-2xl border border-[#E2E8F0] p-4 sm:p-5 shadow-xs space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p id="freeship-status-text" class="text-xs sm:text-sm font-bold text-[#0F172A]">
            Đơn từ <strong class="tabular-nums text-[#047857]">199.000 ₫</strong> được <strong>Miễn phí vận chuyển toàn quốc</strong>!
          </p>
          <span id="freeship-badge" class="text-[11px] font-extrabold px-2.5 py-0.5 rounded-full bg-[#FFF7ED] text-[#9A3412] tabular-nums">
            0 / 199.000 ₫
          </span>
        </div>
        <div class="w-full h-2.5 bg-[#E2E8F0] rounded-full overflow-hidden">
          <div id="freeship-bar-fill" class="h-full bg-[#047857] transition-all duration-300 rounded-full" style="width: 0%"></div>
        </div>
        <div id="freeship-upsell-actions" class="flex flex-wrap items-center gap-2 pt-1">
          <span class="text-xs font-bold text-[#475569]">Mua thêm để nhận Freeship:</span>
          <button
            type="button"
            id="btn-cart-add-glass-45k"
            class="min-h-[40px] px-3 py-1.5 rounded-lg bg-[#FFF7ED] hover:bg-[#FFEDD5] border border-[#FED7AA] text-xs font-extrabold text-[#9A3412] cursor-pointer transition-colors"
          >
            + Lau kính ClearWay 500ml (45.000 ₫)
          </button>
          <button
            type="button"
            id="btn-cart-add-bottle-19k"
            class="min-h-[40px] px-3 py-1.5 rounded-lg bg-[#F8FAFC] hover:bg-[#E2E8F0] border border-[#CBD5E1] text-xs font-bold text-[#0F172A] cursor-pointer transition-colors"
          >
            + Vỏ bình xịt PET 500ml (19.000 ₫)
          </button>
          <button
            type="button"
            id="btn-cart-add-bundle-199k"
            class="min-h-[40px] px-3 py-1.5 rounded-lg bg-[#1E2B6B] hover:bg-[#151E4B] text-xs font-extrabold text-white cursor-pointer transition-colors"
          >
            🎁 Chọn Bộ 3 Toàn Gia 199.000 ₫ (Freeship)
          </button>
        </div>
      </div>

      <!-- Empty Cart State -->
      <div id="cart-page-empty" class="hidden bg-white rounded-2xl border border-[#E2E8F0] p-12 sm:p-16 text-center shadow-xs max-w-xl mx-auto">
        <div class="space-y-4">
          <div class="w-16 h-16 bg-[#F8FAFC] rounded-full flex items-center justify-center mx-auto text-[#64748B] text-2xl border border-[#E2E8F0]">
            <i class="fa-solid fa-cart-shopping"></i>
          </div>
          <h2 class="text-lg font-extrabold text-[#0F172A] font-montserrat uppercase">Giỏ hàng của bạn đang trống</h2>
          <p class="text-xs sm:text-sm text-[#475569] max-w-sm mx-auto leading-relaxed">
            Chọn ngay Combo Đôi Nhà Sạch 145.000 ₫ hoặc Bộ 3 Toàn Gia 199.000 ₫ để được miễn phí giao hàng tận nhà.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
            <a
              href="/san-pham"
              data-cta="empty-cart-shop"
              class="inline-flex items-center justify-center min-h-[48px] bg-[#FF8A15] text-[#0F1638] font-extrabold text-xs uppercase tracking-wider px-7 py-3 rounded-xl hover:bg-[#E57600] transition-colors shadow-xs cursor-pointer font-montserrat"
            >
              Xem 9 Sản Phẩm VKINNO
            </a>
          </div>
        </div>
      </div>

      <!-- Populated Cart Grid -->
      <div id="cart-page-content" class="hidden grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Cart Items List -->
        <div class="lg:col-span-2 space-y-4" id="cart-items-list"></div>

        <!-- Summary Bill -->
        <div class="bg-white p-6 rounded-2xl border border-[#E2E8F0] shadow-xs h-fit space-y-5">
          <h2 class="text-sm font-extrabold text-[#0F172A] uppercase tracking-wider pb-3 border-b border-[#E2E8F0] font-montserrat">
            TÓM TẮT ĐƠN HÀNG
          </h2>

          <!-- Voucher Input Section -->
          <div class="space-y-2" id="voucher-box">
            <label for="cart-voucher-input" class="block text-xs font-extrabold text-[#475569] uppercase tracking-wider">
              Mã ưu đãi (VD: KHACHCU10)
            </label>
            <div class="flex space-x-2">
              <input
                type="text"
                id="cart-voucher-input"
                placeholder="Nhập KHACHCU10 hoặc VKINNO10"
                class="w-full p-2.5 border border-[#CBD5E1] rounded-xl text-base sm:text-xs font-bold uppercase bg-[#F8FAFC] focus:outline-none focus:border-[#1E2B6B] focus:bg-white transition-all text-[#0F172A]"
              />
              <button
                type="button"
                id="btn-cart-apply-voucher"
                class="min-h-[44px] bg-[#1E2B6B] hover:bg-[#151E4B] text-white px-4 py-2.5 rounded-xl text-xs font-extrabold transition-colors shrink-0 cursor-pointer"
              >
                Áp dụng
              </button>
            </div>
            <p id="voucher-msg" class="text-xs font-semibold hidden"></p>
          </div>

          <!-- Price Calculation Rows -->
          <div class="space-y-3 text-sm font-semibold text-[#475569] border-t border-[#E2E8F0] pt-4">
            <div class="flex justify-between items-center">
              <span>Tạm tính (đã gồm VAT 8%)</span>
              <span class="text-[#0F172A] font-extrabold tabular-nums" id="cart-subtotal">0 ₫</span>
            </div>
            <div id="voucher-discount-row" class="hidden justify-between items-center text-[#047857] font-bold">
              <span id="voucher-label">Mã ưu đãi (-10%)</span>
              <span id="cart-discount" class="tabular-nums">-0 ₫</span>
            </div>
            <div class="flex justify-between items-center">
              <span>Phí vận chuyển</span>
              <span class="text-[#0F172A] font-extrabold tabular-nums" id="cart-shipping">25.000 ₫</span>
            </div>
            <p class="text-[11px] text-[#64748B] leading-relaxed">
              * Điều kiện Freeship từ 199.000 ₫ được tính trên Tạm tính trước khi trừ mã ưu đãi.
            </p>
            <div class="border-t border-[#E2E8F0] pt-3 flex justify-between items-center text-[#0F172A] font-extrabold text-base">
              <span>Tổng thanh toán</span>
              <span class="text-[#C81E1E] font-black text-lg tabular-nums" id="cart-grand-total">0 ₫</span>
            </div>
          </div>

          <a
            href="/thanh-toan"
            data-cta="cart-to-checkout"
            class="flex items-center justify-center w-full min-h-[48px] py-3.5 bg-[#FF8A15] hover:bg-[#E57600] text-[#0F1638] text-xs sm:text-sm font-extrabold uppercase tracking-wider rounded-xl transition-colors shadow-sm cursor-pointer font-montserrat"
          >
            TIẾN HÀNH ĐẶT HÀNG →
          </a>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ productLookup, freeshipThreshold, defaultShipping }}>
    const formatVND = (num) => new Intl.NumberFormat("vi-VN").format(Math.round(num)) + " ₫";

    function updateFreeshipBar(subtotal) {
      const statusText = document.getElementById("freeship-status-text");
      const badge = document.getElementById("freeship-badge");
      const barFill = document.getElementById("freeship-bar-fill");
      const upsellActions = document.getElementById("freeship-upsell-actions");

      const pct = Math.min(100, Math.round((subtotal / freeshipThreshold) * 100));
      if (barFill) barFill.style.width = `${pct}%`;

      if (subtotal >= freeshipThreshold) {
        if (statusText) {
          statusText.innerHTML = `<span class="text-[#047857] font-extrabold">🎉 Chúc mừng! Đơn hàng đã đủ điều kiện MIỄN PHÍ VẬN CHUYỂN toàn quốc (giữ nguyên kể cả khi áp mã KHACHCU10).</span>`;
        }
        if (badge) {
          badge.textContent = "ĐÃ FREESHIP 0 ₫";
          badge.className = "text-[11px] font-extrabold px-2.5 py-0.5 rounded-full bg-[#ECFDF5] text-[#047857] tabular-nums";
        }
        if (upsellActions) upsellActions.classList.add("hidden");
      } else {
        const remaining = freeshipThreshold - subtotal;
        if (statusText) {
          statusText.innerHTML = subtotal > 0
            ? `Mua thêm chỉ <strong class="text-[#C81E1E] tabular-nums">${formatVND(remaining)}</strong> nữa để được <strong class="text-[#047857]">Miễn phí vận chuyển toàn quốc</strong> (tiết kiệm 25.000 ₫ phí ship)!`
            : `Đơn từ <strong class="tabular-nums text-[#047857]">199.000 ₫</strong> được <strong>Miễn phí vận chuyển toàn quốc</strong>!`;
        }
        if (badge) {
          badge.textContent = `${formatVND(subtotal)} / 199.000 ₫`;
          badge.className = "text-[11px] font-extrabold px-2.5 py-0.5 rounded-full bg-[#FFF7ED] text-[#9A3412] tabular-nums";
        }
        if (upsellActions) upsellActions.classList.remove("hidden");
      }
    }

    function renderPageCart() {
      const cart = JSON.parse(localStorage.getItem("vkinno_cart") || "[]");
      const emptyBox = document.getElementById("cart-page-empty");
      const contentBox = document.getElementById("cart-page-content");
      const list = document.getElementById("cart-items-list");
      const voucherInput = document.getElementById("cart-voucher-input");

      const subtotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);
      updateFreeshipBar(subtotal);

      if (cart.length === 0) {
        if (emptyBox) emptyBox.classList.remove("hidden");
        if (contentBox) {
          contentBox.classList.add("hidden");
          contentBox.classList.remove("grid");
        }
        return;
      }

      if (emptyBox) emptyBox.classList.add("hidden");
      if (contentBox) {
        contentBox.classList.remove("hidden");
        contentBox.classList.add("grid");
      }

      if (list) {
        list.innerHTML = cart
          .map((item, idx) => {
            let imgUrl = item.image;
            let itemSlug = item.slug;
            if ((!imgUrl || imgUrl.startsWith("http")) && productLookup && productLookup[item.name]) {
              imgUrl = productLookup[item.name].image;
              if (!itemSlug) itemSlug = productLookup[item.name].slug;
            }
            if (!imgUrl || imgUrl.startsWith("http")) imgUrl = "/logo.png";

            return `
              <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between p-4 bg-white border border-[#E2E8F0] rounded-2xl shadow-xs gap-4">
                <div class="flex items-center space-x-4 min-w-0">
                  <div class="w-16 h-16 rounded-xl overflow-hidden bg-[#F8FAFC] shrink-0 border border-[#E2E8F0]">
                    <img
                      src="${imgUrl}"
                      alt="${item.name}"
                      width="64"
                      height="64"
                      loading="lazy"
                      onerror="this.onerror=null; this.src='/logo.png';"
                      class="w-full h-full object-contain p-1"
                    />
                  </div>
                  <div class="space-y-1 min-w-0">
                    <a href="/san-pham/${itemSlug || ""}" class="text-[#0F172A] font-bold text-xs sm:text-sm line-clamp-2 hover:text-[#1E2B6B] transition-colors">
                      ${item.name}
                    </a>
                    <span class="block text-xs text-[#C81E1E] font-extrabold tabular-nums">${formatVND(item.price)}</span>
                  </div>
                </div>

                <div class="flex items-center justify-between sm:justify-end space-x-6 border-t sm:border-t-0 border-[#E2E8F0] pt-3 sm:pt-0 shrink-0">
                  <div class="flex items-center border border-[#CBD5E1] rounded-xl h-10 px-1 bg-[#F8FAFC]">
                    <button type="button" aria-label="Giảm số lượng" onclick="window.vkinnoPageUpdateQty(${idx}, -1)" class="w-8 h-8 rounded-lg hover:bg-white flex items-center justify-center text-[#0F172A] font-bold cursor-pointer">
                      -
                    </button>
                    <span class="w-8 text-center text-sm font-extrabold text-[#0F172A] tabular-nums">${item.quantity}</span>
                    <button type="button" aria-label="Tăng số lượng" onclick="window.vkinnoPageUpdateQty(${idx}, 1)" class="w-8 h-8 rounded-lg hover:bg-white flex items-center justify-center text-[#0F172A] font-bold cursor-pointer">
                      +
                    </button>
                  </div>

                  <div class="flex items-center space-x-4">
                    <span class="text-sm font-black text-[#0F172A] w-24 text-right tabular-nums">${formatVND(item.price * item.quantity)}</span>
                    <button type="button" onclick="window.vkinnoPageRemove(${idx})" class="w-9 h-9 rounded-lg text-[#64748B] hover:text-[#C81E1E] hover:bg-[#FEF2F2] flex items-center justify-center transition-colors cursor-pointer" aria-label="Xoá sản phẩm">
                      <i class="fa-regular fa-trash-can text-base"></i>
                    </button>
                  </div>
                </div>
              </div>
            `;
          })
          .join("");
      }

      // Freeship evaluated on subtotal BEFORE voucher discount!
      const shipping = subtotal >= freeshipThreshold ? 0 : defaultShipping;

      let voucherDiscount = 0;
      let activeCode = "";
      const storedVoucher = sessionStorage.getItem("vkinno_cart_voucher");
      if (storedVoucher) {
        try {
          const v = JSON.parse(storedVoucher);
          if (v.code === "KHACHCU10" || v.code === "VKINNO10") {
            activeCode = v.code;
            voucherDiscount = Math.round(subtotal * 0.1);
            if (voucherInput && !voucherInput.value) voucherInput.value = activeCode;
          }
        } catch {}
      }

      const total = Math.max(0, subtotal - voucherDiscount + shipping);

      const subtotalEl = document.getElementById("cart-subtotal");
      const shippingEl = document.getElementById("cart-shipping");
      const totalEl = document.getElementById("cart-grand-total");
      const discountRow = document.getElementById("voucher-discount-row");
      const discountEl = document.getElementById("cart-discount");
      const voucherLabel = document.getElementById("voucher-label");

      if (subtotalEl) subtotalEl.textContent = formatVND(subtotal);
      if (shippingEl) {
        shippingEl.textContent = shipping === 0 ? "Miễn phí (0 ₫)" : formatVND(shipping);
        shippingEl.className = shipping === 0 ? "text-[#047857] font-extrabold tabular-nums" : "text-[#0F172A] font-extrabold tabular-nums";
      }
      if (totalEl) totalEl.textContent = formatVND(total);

      if (voucherDiscount > 0 && discountRow && discountEl) {
        discountRow.classList.remove("hidden");
        discountRow.classList.add("flex");
        if (voucherLabel) voucherLabel.textContent = `Mã ${activeCode} (-10%)`;
        discountEl.textContent = "-" + formatVND(voucherDiscount);
      } else if (discountRow) {
        discountRow.classList.add("hidden");
        discountRow.classList.remove("flex");
      }
    }

    window.vkinnoPageUpdateQty = function (idx, delta) {
      const cart = JSON.parse(localStorage.getItem("vkinno_cart") || "[]");
      if (!cart[idx]) return;
      cart[idx].quantity += delta;
      if (cart[idx].quantity <= 0) cart.splice(idx, 1);
      localStorage.setItem("vkinno_cart", JSON.stringify(cart));
      if (window.vkinnoUpdateCartUI) window.vkinnoUpdateCartUI();
      renderPageCart();
    };

    window.vkinnoPageRemove = function (idx) {
      const cart = JSON.parse(localStorage.getItem("vkinno_cart") || "[]");
      cart.splice(idx, 1);
      localStorage.setItem("vkinno_cart", JSON.stringify(cart));
      if (window.vkinnoUpdateCartUI) window.vkinnoUpdateCartUI();
      renderPageCart();
    };

    document.getElementById("btn-cart-add-glass-45k")?.addEventListener("click", () => {
      if (window.vkinnoAddToCart) {
        window.vkinnoAddToCart(
          "Nước lau kính ClearWay GlassPro 500ml sạch trong không vệt cho kính nhà & văn phòng",
          45000,
          "/images/products/vk-clearway-glasspro-500ml.jpg",
          "nuoc-lau-kinh-clearway-glasspro-500ml-sach-nhanh-khong-vet-sang-bong-kinh-nha-van-phong",
          1,
          "VK-CLEARWAY-GLASSPRO-500ML"
        );
        renderPageCart();
      }
    });

    document.getElementById("btn-cart-add-bottle-19k")?.addEventListener("click", () => {
      if (window.vkinnoAddToCart) {
        window.vkinnoAddToCart(
          "Chai xịt rỗng 500ml bình xịt nhựa PET dày phun sương có khóa an toàn",
          19000,
          "/images/products/vk-bottle-spray-500ml.jpg",
          "bo-chai-xit-500ml-phun-suong",
          1,
          "VK-BOTTLE-SPRAY-500ML"
        );
        renderPageCart();
      }
    });

    document.getElementById("btn-cart-add-bundle-199k")?.addEventListener("click", () => {
      if (window.vkinnoAddToCart) {
        window.vkinnoAddToCart(
          "Chai xịt tẩy cặn canxi 500ml Bossman làm sạch vách kính nhà tắm và sen vòi inox",
          69000,
          "/images/products/vk-bossman-descaler-500ml.jpg",
          "chai-xit-tay-can-canxi-500ml-an-toan-cho-da-tay-dung-dich-tay-can-canxi-lam-sach-voi-sen-va-nha-tam",
          1,
          "VK-BOSSMAN-DESCALER-500ML"
        );
        window.vkinnoAddToCart(
          "Chai xịt tẩy dầu mỡ đa năng VKINNO 500ml chuyên dụng cho bếp từ và lưới lọc hút mùi",
          85000,
          "/images/products/vk-degreaser-500ml.jpg",
          "tay-dau-mo-da-nang-cao-cap-vkinno-500ml-chuyen-dung-cho-bep-tu-bep-hong-ngoai-an-toan-be-mat-bep",
          1,
          "VK-DEGREASER-500ML"
        );
        window.vkinnoAddToCart(
          "Nước lau kính ClearWay GlassPro 500ml sạch trong không vệt cho kính nhà & văn phòng",
          45000,
          "/images/products/vk-clearway-glasspro-500ml.jpg",
          "nuoc-lau-kinh-clearway-glasspro-500ml-sach-nhanh-khong-vet-sang-bong-kinh-nha-van-phong",
          1,
          "VK-CLEARWAY-GLASSPRO-500ML"
        );
        renderPageCart();
      }
    });

    const applyVoucherBtn = document.getElementById("btn-cart-apply-voucher");
    const voucherInput = document.getElementById("cart-voucher-input");
    const voucherMsg = document.getElementById("voucher-msg");

    applyVoucherBtn?.addEventListener("click", () => {
      const code = voucherInput?.value?.trim().toUpperCase();
      if (!code) {
        sessionStorage.removeItem("vkinno_cart_voucher");
        if (voucherMsg) voucherMsg.className = "hidden";
        renderPageCart();
        return;
      }
      if (code === "KHACHCU10" || code === "VKINNO10") {
        sessionStorage.setItem("vkinno_cart_voucher", JSON.stringify({ code, name: "Giảm 10% giá trị hàng hóa" }));
        if (voucherMsg) {
          voucherMsg.textContent = `Đã áp dụng mã ${code}: Giảm 10% (vẫn giữ nguyên Freeship nếu tạm tính từ 199.000 ₫).`;
          voucherMsg.className = "text-xs font-semibold text-[#047857] block";
        }
      } else {
        if (voucherMsg) {
          voucherMsg.textContent = "Mã ưu đãi không tồn tại. Bạn có thể dùng mã KHACHCU10 trên thẻ cảm ơn VKINNO.";
          voucherMsg.className = "text-xs font-semibold text-[#C81E1E] block";
        }
      }
      renderPageCart();
    });

    window.addEventListener("vkinno-live-catalog", renderPageCart);
    renderPageCart();
  </script>
</Layout>
