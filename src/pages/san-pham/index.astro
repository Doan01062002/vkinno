---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { products } from "../../data/products";

const categories = [
  { id: 0, name: "Tất cả sản phẩm", count: products.length },
  { id: 1, name: "Tẩy Rửa Gia Đình & Pin Mặt Trời", count: products.filter((p) => p.category_id === 1).length },
  { id: 3, name: "Chăm Sóc Kính & Ô Tô", count: products.filter((p) => p.category_id === 3).length },
  { id: 2, name: "Dụng Cụ & Bình Xịt PET", count: products.filter((p) => p.category_id === 2).length },
];
---

<Layout
  title="Cửa Hàng Chính Hãng VKINNO - Bảng Giá 9 Mã Sản Phẩm (Đã Gồm VAT 8%)"
  description="Khám phá danh mục 9 sản phẩm tẩy cặn canxi Bossman, tẩy dầu mỡ nhà bếp, nước lau kính ClearWay, VisionX Clean và dung dịch vệ sinh tấm pin mặt trời Solar Shield chính hãng VKINNO."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-6 sm:py-8 space-y-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs font-semibold text-[#475569]" aria-label="Breadcrumb">
      <a href="/" class="hover:text-[#1E2B6B] transition-colors">Trang chủ</a>
      <span>/</span>
      <span class="text-[#0F172A] font-bold">Cửa hàng chính hãng</span>
    </nav>

    <!-- Page H1 + Freeship Callout -->
    <div class="bg-white p-5 sm:p-6 rounded-2xl border border-[#E2E8F0] shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="space-y-1">
        <h1 class="text-xl sm:text-2xl font-extrabold text-[#0F172A] font-montserrat">
          Cửa Hàng Chính Hãng VKINNO
        </h1>
        <p class="text-xs sm:text-sm text-[#475569]">
          Toàn bộ giá niêm yết đã bao gồm thuế VAT 8% · Giao trực tiếp từ kho Vĩnh Khang (Di Trạch, Hoài Đức, Hà Nội).
        </p>
      </div>
      <div class="bg-[#FFF7ED] border border-[#FED7AA] px-4 py-2.5 rounded-xl text-xs font-bold text-[#9A3412] flex items-center gap-2 shrink-0">
        <i class="fa-solid fa-truck-fast text-[#A84B00]"></i>
        <span>Đơn từ <strong class="tabular-nums">199.000 ₫</strong> miễn phí vận chuyển toàn quốc!</span>
      </div>
    </div>

    <!-- Main Store Layout: 2 Columns -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Left Sidebar Filters (Desktop Sticky) -->
      <aside class="hidden lg:block lg:sticky lg:top-24 h-fit space-y-6">
        <div class="bg-white p-5 rounded-2xl border border-[#E2E8F0] shadow-xs space-y-3">
          <label for="sidebar-search-input" class="block text-xs font-extrabold uppercase tracking-wider text-[#0F172A] font-montserrat">
            TÌM KIẾM SẢN PHẨM
          </label>
          <div class="relative">
            <input
              type="text"
              id="sidebar-search-input"
              placeholder="Tên chai, công dụng..."
              class="w-full pl-3.5 pr-10 py-2.5 bg-[#F8FAFC] border border-[#CBD5E1] rounded-xl text-base lg:text-sm focus:outline-none focus:border-[#1E2B6B] transition-all text-[#0F172A] font-medium"
            />
            <button
              type="button"
              aria-label="Tìm kiếm sản phẩm"
              class="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 flex items-center justify-center text-[#475569] hover:text-[#1E2B6B] cursor-pointer"
              id="sidebar-search-btn"
            >
              <i class="fa-solid fa-magnifying-glass text-xs"></i>
            </button>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-[#E2E8F0] shadow-xs space-y-3">
          <h2 class="text-xs font-extrabold uppercase tracking-wider text-[#0F172A] font-montserrat">
            DANH MỤC
          </h2>
          <ul class="space-y-1.5 text-xs font-bold" id="category-filter-list">
            {categories.map((cat) => (
              <li>
                <button
                  type="button"
                  class={`w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-left transition-colors cursor-pointer cat-filter-btn ${
                    cat.id === 0
                      ? "bg-[#FFF7ED] text-[#A84B00] border-l-3 border-[#FF8A15] font-extrabold"
                      : "text-[#475569] hover:bg-[#F8FAFC] hover:text-[#0F172A]"
                  }`}
                  data-cat-id={cat.id}
                >
                  <span>{cat.name}</span>
                  <span class="text-[11px] tabular-nums bg-[#F1F5F9] text-[#475569] px-2 py-0.5 rounded-full">{cat.count}</span>
                </button>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-[#E2E8F0] shadow-xs space-y-3">
          <label for="brand-select" class="block text-xs font-extrabold uppercase tracking-wider text-[#0F172A] font-montserrat">
            NHÃN HIỆU
          </label>
          <select
            id="brand-select"
            class="w-full px-3 py-2.5 bg-[#F8FAFC] border border-[#CBD5E1] rounded-xl text-base lg:text-sm font-semibold text-[#0F172A] focus:outline-none focus:border-[#1E2B6B]"
          >
            <option value="">Tất cả nhãn hiệu</option>
            <option value="VKINNO">VKINNO</option>
            <option value="Bossman">Bossman</option>
            <option value="ClearWay">ClearWay</option>
            <option value="VisionX">VisionX</option>
          </select>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-[#E2E8F0] shadow-xs space-y-3">
          <h2 class="text-xs font-extrabold uppercase tracking-wider text-[#0F172A] font-montserrat">
            KHOẢNG GIÁ (VND)
          </h2>
          <div class="grid grid-cols-2 gap-2">
            <input
              type="number"
              id="price-min"
              aria-label="Giá tối thiểu"
              placeholder="Từ (đ)"
              class="w-full px-3 py-2 bg-[#F8FAFC] border border-[#CBD5E1] rounded-lg text-base lg:text-sm tabular-nums"
            />
            <input
              type="number"
              id="price-max"
              aria-label="Giá tối đa"
              placeholder="Đến (đ)"
              class="w-full px-3 py-2 bg-[#F8FAFC] border border-[#CBD5E1] rounded-lg text-base lg:text-sm tabular-nums"
            />
          </div>
          <button
            type="button"
            id="btn-apply-price"
            class="w-full min-h-[44px] bg-[#1E2B6B] text-white hover:bg-[#FF8A15] hover:text-[#0F1638] font-extrabold text-xs uppercase tracking-wide py-2.5 rounded-xl transition-colors shadow-xs cursor-pointer"
          >
            Lọc theo giá
          </button>
        </div>
      </aside>

      <!-- Right Products Area -->
      <section class="lg:col-span-3 space-y-6">
        <div class="bg-white p-4 rounded-2xl border border-[#E2E8F0] shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-xs font-bold text-[#475569]">
          <div>
            Hiển thị <span id="product-count-display" class="text-[#0F172A] font-extrabold tabular-nums">{products.length}</span> / <span class="tabular-nums">{products.length}</span> sản phẩm
          </div>
          <div class="flex items-center space-x-3 w-full sm:w-auto">
            <button
              type="button"
              id="btn-mobile-filter-trigger"
              class="flex lg:hidden flex-1 items-center justify-center space-x-2 bg-[#1E2B6B] hover:bg-[#151E4B] text-white px-4 py-2.5 rounded-xl font-bold text-xs transition-colors shadow-xs min-h-[44px] cursor-pointer"
            >
              <i class="fa-solid fa-filter text-xs text-[#FF8A15]"></i>
              <span>Bộ lọc</span>
              <span id="active-cat-badge" class="hidden px-1.5 py-0.5 rounded-full bg-[#FF8A15] text-[#0F1638] text-[10px] font-black">1</span>
            </button>

            <div class="flex items-center space-x-2 flex-1 sm:flex-none">
              <label for="sort-select" class="text-[#475569] hidden sm:inline">Sắp xếp:</label>
              <select
                id="sort-select"
                aria-label="Sắp xếp sản phẩm"
                class="w-full sm:w-auto min-h-[44px] px-3 py-2 bg-[#F8FAFC] border border-[#CBD5E1] rounded-xl text-base sm:text-xs font-bold text-[#0F172A] focus:outline-none focus:border-[#1E2B6B]"
              >
                <option value="default">Bán chạy &amp; Đề xuất</option>
                <option value="price-asc">Giá: Thấp đến Cao</option>
                <option value="price-desc">Giá: Cao đến Thấp</option>
                <option value="name-asc">Tên: A - Z</option>
              </select>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 sm:gap-6" id="products-catalog-grid">
          {products.map((product) => (
            <div
              class="store-product-item"
              data-category={product.category_id}
              data-brand={product.brand || "VKINNO"}
              data-price={product.price_vnd}
              data-name={product.name.toLowerCase()}
            >
              <ProductCard product={product} />
            </div>
          ))}
        </div>

        <div class="hidden text-center py-16 bg-white rounded-2xl border border-[#E2E8F0] p-8 space-y-4" id="no-products-msg">
          <i class="fa-solid fa-magnifying-glass text-3xl text-[#94A3B8]"></i>
          <p class="text-sm font-bold text-[#0F172A]">Không tìm thấy sản phẩm phù hợp với điều kiện lọc</p>
          <button
            type="button"
            id="reset-filters-btn"
            class="min-h-[44px] px-5 py-2.5 bg-[#FF8A15] text-[#0F1638] text-xs font-extrabold uppercase rounded-xl hover:bg-[#E57600] cursor-pointer"
          >
            Xem lại toàn bộ sản phẩm
          </button>
        </div>
      </section>
    </div>
  </div>

  <!-- Mobile Slide-In Filters Drawer -->
  <div id="mobile-filter-drawer" class="fixed inset-0 bg-black/50 backdrop-blur-xs z-[250] hidden opacity-0 transition-opacity duration-300">
    <div id="mobile-filter-content" class="fixed right-0 top-0 bottom-0 w-80 max-w-[85vw] bg-white p-6 shadow-2xl flex flex-col justify-between transform translate-x-full transition-transform duration-300">
      <div class="flex flex-col h-full">
        <div class="flex items-center justify-between pb-4 border-b border-[#E2E8F0] mb-4 shrink-0">
          <h3 class="font-extrabold text-[#0F172A] uppercase tracking-wider text-xs flex items-center gap-2">
            <i class="fa-solid fa-filter text-[#A84B00]"></i> Bộ lọc sản phẩm
          </h3>
          <button
            type="button"
            id="mobile-filter-close"
            aria-label="Đóng bộ lọc"
            class="w-11 h-11 flex items-center justify-center text-[#475569] hover:text-[#0F172A] transition-colors focus:outline-none cursor-pointer"
          >
            <i class="fa-solid fa-xmark text-lg"></i>
          </button>
        </div>

        <div class="flex-grow overflow-y-auto pr-1 space-y-6">
          <div class="space-y-2">
            <label for="mobile-filter-search" class="block text-xs font-extrabold text-[#0F172A] uppercase tracking-wider pb-1 border-b border-[#E2E8F0]">Tìm kiếm</label>
            <input
              type="text"
              id="mobile-filter-search"
              placeholder="Nhập tên sản phẩm..."
              class="w-full px-3 py-2.5 text-base border border-[#CBD5E1] rounded-xl bg-[#F8FAFC] focus:outline-none focus:border-[#1E2B6B]"
            />
          </div>

          <div class="space-y-2">
            <h4 class="text-xs font-extrabold text-[#0F172A] uppercase tracking-wider pb-1 border-b border-[#E2E8F0]">Danh mục</h4>
            <ul class="space-y-1.5 text-sm font-semibold text-[#475569]">
              {categories.map((cat) => (
                <li>
                  <button
                    type="button"
                    class="w-full flex items-center justify-between py-2 hover:text-[#A84B00] transition-colors mobile-cat-btn text-left cursor-pointer"
                    data-cat-id={cat.id}
                  >
                    <span>{cat.name}</span>
                    <span class="text-xs tabular-nums text-[#64748B]">{cat.count}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <div class="space-y-2">
            <label for="mobile-filter-brand" class="block text-xs font-extrabold text-[#0F172A] uppercase tracking-wider pb-1 border-b border-[#E2E8F0]">Nhãn hiệu</label>
            <select
              id="mobile-filter-brand"
              class="w-full text-base font-semibold p-2.5 border border-[#CBD5E1] rounded-xl bg-[#F8FAFC] focus:outline-none focus:border-[#1E2B6B]"
            >
              <option value="">Tất cả nhãn hiệu</option>
              <option value="VKINNO">VKINNO</option>
              <option value="Bossman">Bossman</option>
              <option value="ClearWay">ClearWay</option>
              <option value="VisionX">VisionX</option>
            </select>
          </div>

          <div class="space-y-2">
            <h4 class="text-xs font-extrabold text-[#0F172A] uppercase tracking-wider pb-1 border-b border-[#E2E8F0]">Khoảng giá</h4>
            <div class="grid grid-cols-2 gap-2">
              <input type="number" id="mobile-price-min" aria-label="Giá từ" placeholder="Từ (đ)" class="w-full p-2.5 text-base border border-[#CBD5E1] rounded-xl bg-[#F8FAFC]" />
              <input type="number" id="mobile-price-max" aria-label="Giá đến" placeholder="Đến (đ)" class="w-full p-2.5 text-base border border-[#CBD5E1] rounded-xl bg-[#F8FAFC]" />
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-[#E2E8F0] mt-4 flex items-center gap-3 shrink-0">
          <button type="button" id="btn-mobile-reset-filters" class="flex-1 min-h-[44px] bg-[#F1F5F9] hover:bg-[#E2E8F0] text-[#0F172A] font-bold text-xs py-2.5 rounded-xl transition-colors cursor-pointer">
            Đặt lại
          </button>
          <button type="button" id="btn-mobile-apply-filters-close" class="flex-1 min-h-[44px] bg-[#FF8A15] text-[#0F1638] hover:bg-[#E57600] font-extrabold text-xs py-2.5 rounded-xl transition-colors cursor-pointer">
            Xem kết quả
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const urlParams = new URLSearchParams(window.location.search);
  let activeCat = parseInt(urlParams.get("category") || "0", 10) || 0;
  const searchQuery = (urlParams.get("search") || urlParams.get("q") || "").toLowerCase().trim();

  const searchInput = document.getElementById("sidebar-search-input") as HTMLInputElement | null;
  const brandSelect = document.getElementById("brand-select") as HTMLSelectElement | null;
  const sortSelect = document.getElementById("sort-select") as HTMLSelectElement | null;
  const priceMin = document.getElementById("price-min") as HTMLInputElement | null;
  const priceMax = document.getElementById("price-max") as HTMLInputElement | null;
  const applyPriceBtn = document.getElementById("btn-apply-price");
  const resetBtn = document.getElementById("reset-filters-btn");
  const countDisplay = document.getElementById("product-count-display");
  const noProductsMsg = document.getElementById("no-products-msg");
  const grid = document.getElementById("products-catalog-grid");
  const items = document.querySelectorAll<HTMLElement>(".store-product-item");
  const catButtons = document.querySelectorAll<HTMLButtonElement>(".cat-filter-btn");

  const mobileDrawer = document.getElementById("mobile-filter-drawer");
  const mobileContent = document.getElementById("mobile-filter-content");
  const mobileTrigger = document.getElementById("btn-mobile-filter-trigger");
  const mobileClose = document.getElementById("mobile-filter-close");
  const mobileApplyClose = document.getElementById("btn-mobile-apply-filters-close");
  const mobileReset = document.getElementById("btn-mobile-reset-filters");
  const mobileSearchInput = document.getElementById("mobile-filter-search") as HTMLInputElement | null;
  const mobileBrandSelect = document.getElementById("mobile-filter-brand") as HTMLSelectElement | null;
  const mobilePriceMin = document.getElementById("mobile-price-min") as HTMLInputElement | null;
  const mobilePriceMax = document.getElementById("mobile-price-max") as HTMLInputElement | null;
  const mobileCatButtons = document.querySelectorAll<HTMLButtonElement>(".mobile-cat-btn");

  if (searchQuery && searchInput) searchInput.value = searchQuery;
  if (searchQuery && mobileSearchInput) mobileSearchInput.value = searchQuery;

  function applyFilters() {
    let visibleCount = 0;
    const query = (mobileSearchInput?.value || searchInput?.value || "").toLowerCase().trim();
    const brand = mobileBrandSelect?.value || brandSelect?.value || "";
    const minP = parseFloat(mobilePriceMin?.value || priceMin?.value || "0") || 0;
    const maxP = parseFloat(mobilePriceMax?.value || priceMax?.value || "999999999") || 999999999;

    items.forEach((item) => {
      const catId = parseInt(item.dataset.category || "0", 10);
      const itBrand = item.dataset.brand || "";
      const itPrice = parseFloat(item.dataset.price || "0");
      const itName = item.dataset.name || "";

      const matchCat = activeCat === 0 || catId === activeCat;
      const matchBrand = !brand || itBrand === brand;
      const matchPrice = itPrice >= minP && itPrice <= maxP;
      const matchQuery = !query || itName.includes(query);

      if (matchCat && matchBrand && matchPrice && matchQuery) {
        item.style.display = "";
        visibleCount++;
      } else {
        item.style.display = "none";
      }
    });

    if (countDisplay) countDisplay.textContent = String(visibleCount);
    if (noProductsMsg && grid) {
      if (visibleCount === 0) {
        noProductsMsg.classList.remove("hidden");
        grid.classList.add("hidden");
      } else {
        noProductsMsg.classList.add("hidden");
        grid.classList.remove("hidden");
      }
    }

    catButtons.forEach((btn) => {
      const cId = parseInt(btn.dataset.catId || "0", 10);
      if (cId === activeCat) {
        btn.classList.add("bg-[#FFF7ED]", "text-[#A84B00]", "border-l-3", "border-[#FF8A15]", "font-extrabold");
        btn.classList.remove("text-[#475569]");
      } else {
        btn.classList.remove("bg-[#FFF7ED]", "text-[#A84B00]", "border-l-3", "border-[#FF8A15]", "font-extrabold");
        btn.classList.add("text-[#475569]");
      }
    });

    mobileCatButtons.forEach((btn) => {
      const cId = parseInt(btn.dataset.catId || "0", 10);
      if (cId === activeCat) {
        btn.classList.add("text-[#A84B00]", "font-extrabold");
        btn.classList.remove("text-[#475569]");
      } else {
        btn.classList.remove("text-[#A84B00]", "font-extrabold");
        btn.classList.add("text-[#475569]");
      }
    });

    const activeBadge = document.getElementById("active-cat-badge");
    let activeFilterCount = 0;
    if (activeCat !== 0) activeFilterCount++;
    if (brand) activeFilterCount++;
    if (minP > 0 || maxP < 999999999) activeFilterCount++;
    if (query) activeFilterCount++;

    if (activeBadge) {
      if (activeFilterCount > 0) {
        activeBadge.textContent = String(activeFilterCount);
        activeBadge.classList.remove("hidden");
      } else {
        activeBadge.classList.add("hidden");
      }
    }
  }

  catButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCat = parseInt(btn.dataset.catId || "0", 10);
      applyFilters();
    });
  });

  searchInput?.addEventListener("input", applyFilters);
  document.getElementById("sidebar-search-btn")?.addEventListener("click", applyFilters);
  brandSelect?.addEventListener("change", applyFilters);
  applyPriceBtn?.addEventListener("click", applyFilters);

  resetBtn?.addEventListener("click", () => {
    activeCat = 0;
    if (searchInput) searchInput.value = "";
    if (brandSelect) brandSelect.value = "";
    if (priceMin) priceMin.value = "";
    if (priceMax) priceMax.value = "";
    applyFilters();
  });

  sortSelect?.addEventListener("change", () => {
    const val = sortSelect.value;
    if (!grid) return;
    const itemArray = Array.from(items);
    itemArray.sort((a, b) => {
      const pA = parseFloat(a.dataset.price || "0");
      const pB = parseFloat(b.dataset.price || "0");
      const nA = a.dataset.name || "";
      const nB = b.dataset.name || "";
      if (val === "price-asc") return pA - pB;
      if (val === "price-desc") return pB - pA;
      if (val === "name-asc") return nA.localeCompare(nB, "vi");
      return 0;
    });
    itemArray.forEach((it) => grid.appendChild(it));
  });

  function openMobileFilter() {
    if (!mobileDrawer || !mobileContent) return;
    mobileDrawer.classList.remove("hidden");
    requestAnimationFrame(() => {
      mobileDrawer.classList.remove("opacity-0");
      mobileContent.classList.remove("translate-x-full");
    });
    document.body.style.overflow = "hidden";
  }

  function closeMobileFilter() {
    if (!mobileDrawer || !mobileContent) return;
    mobileDrawer.classList.add("opacity-0");
    mobileContent.classList.add("translate-x-full");
    setTimeout(() => {
      mobileDrawer.classList.add("hidden");
      document.body.style.overflow = "";
    }, 300);
  }

  mobileTrigger?.addEventListener("click", openMobileFilter);
  mobileClose?.addEventListener("click", closeMobileFilter);
  mobileDrawer?.addEventListener("click", (e) => {
    if (e.target === mobileDrawer) closeMobileFilter();
  });

  mobileCatButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeCat = parseInt(btn.dataset.catId || "0", 10);
      applyFilters();
      closeMobileFilter();
    });
  });

  mobileSearchInput?.addEventListener("input", () => {
    if (searchInput) searchInput.value = mobileSearchInput.value;
    applyFilters();
  });

  mobileBrandSelect?.addEventListener("change", () => {
    if (brandSelect) brandSelect.value = mobileBrandSelect.value;
    applyFilters();
  });

  mobileApplyClose?.addEventListener("click", () => {
    if (priceMin && mobilePriceMin) priceMin.value = mobilePriceMin.value;
    if (priceMax && mobilePriceMax) priceMax.value = mobilePriceMax.value;
    applyFilters();
    closeMobileFilter();
  });

  mobileReset?.addEventListener("click", () => {
    activeCat = 0;
    if (searchInput) searchInput.value = "";
    if (mobileSearchInput) mobileSearchInput.value = "";
    if (brandSelect) brandSelect.value = "";
    if (mobileBrandSelect) mobileBrandSelect.value = "";
    if (priceMin) priceMin.value = "";
    if (mobilePriceMin) mobilePriceMin.value = "";
    if (priceMax) priceMax.value = "";
    if (mobilePriceMax) mobilePriceMax.value = "";
    applyFilters();
    closeMobileFilter();
  });

  applyFilters();
</script>
