        </div>
      </div>
    </section>

    <!-- ==================== 2. FEATURED CATEGORIES ==================== -->
    <section class="w-full max-w-7xl mx-auto px-4 sm:px-8 pt-8 pb-12 sm:py-14 bg-white" id="home-section-categories">
      <div class="space-y-8">
        <div class="flex flex-col items-center text-center space-y-2">
          <h2 class="text-xl sm:text-2xl font-extrabold text-[#0F172A] tracking-wider uppercase font-montserrat">
            DANH MỤC GIẢI PHÁP CHỦ LỰC
          </h2>
          <div class="w-16 h-1 bg-[#FF8A15] rounded"></div>
          <p class="text-xs sm:text-sm text-[#475569] font-medium max-w-lg">
            9 sản phẩm chuẩn hóa từ kho VKINNO Hoài Đức — đầy đủ hướng dẫn ủ hóa chất và cảnh báo bề mặt rõ ràng
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <a class="group relative block rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-[#E2E8F0]" href="/san-pham?category=1">
            <div class="w-full aspect-[4/3] overflow-hidden relative bg-[#F1F5F9]">
              <img
                alt="Tẩy Cặn Canxi, Nhà Bếp & Pin Mặt Trời"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                src="/images/blog/cat-tay-rua.jpg"
                width="480"
                height="360"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0F1638]/90 via-[#0F1638]/35 to-transparent"></div>
            </div>
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <h3 class="text-sm sm:text-base font-extrabold uppercase tracking-wide">
                Nhà Tắm, Nhà Bếp &amp; Solar
              </h3>
              <p class="text-xs text-slate-200 font-semibold mt-1">
                Bossman · Tẩy dầu mỡ · ClearWay · Solar Shield
              </p>
            </div>
          </a>

          <a class="group relative block rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-[#E2E8F0]" href="/san-pham?category=3">
            <div class="w-full aspect-[4/3] overflow-hidden relative bg-[#F1F5F9]">
              <img
                alt="Chăm Sóc Kính & Ngoại Thất Ô Tô"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                src="/images/blog/cat-oto.jpg"
                width="480"
                height="360"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0F1638]/90 via-[#0F1638]/35 to-transparent"></div>
            </div>
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <h3 class="text-sm sm:text-base font-extrabold uppercase tracking-wide">
                Chăm Sóc Ô Tô &amp; Gara
              </h3>
              <p class="text-xs text-slate-200 font-semibold mt-1">
                ClearWay Can 5L 0% Methanol · VisionX Clean
              </p>
            </div>
          </a>

          <a class="group relative block rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-[#E2E8F0]" href="/san-pham?category=2">
            <div class="w-full aspect-[4/3] overflow-hidden relative bg-[#F1F5F9]">
              <img
                alt="Dụng Cụ Pha Chế & Bình Xịt Định Lượng"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                src="/images/blog/cat-dung-cu.jpg"
                width="480"
                height="360"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0F1638]/90 via-[#0F1638]/35 to-transparent"></div>
            </div>
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <h3 class="text-sm sm:text-base font-extrabold uppercase tracking-wide">
                Dụng Cụ &amp; Bình Xịt PET
              </h3>
              <p class="text-xs text-slate-200 font-semibold mt-1">
                Vỏ bình xịt kháng hóa chất 500ml sang chiết can 5L
