---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { products } from "../data/products";
import { SITE_CONFIG } from "../data/siteConfig";
import postsData from "../data/posts.json";

const bestsellerSlugs = [
  "combo-chai-xit-tay-can-canxi-500ml-va-chai-tay-dau-mo-an-toan-da-tay-cong-thuc-moi-sach-vuot-troi---combobossmanvkinno-1782568108",
  "chai-xit-tay-can-canxi-500ml-an-toan-cho-da-tay-dung-dich-tay-can-canxi-lam-sach-voi-sen-va-nha-tam",
  "tay-dau-mo-da-nang-cao-cap-vkinno-500ml-chuyen-dung-cho-bep-tu-bep-hong-ngoai-an-toan-be-mat-bep",
  "dung-dich-ve-sinh-tam-pin-mat-troi-solar-shield-dam-dac-giup-tang-hieu-suat-dien-tang-kem-binh-xit",
];

const newArrivalSlugs = [
  "nuoc-lau-kinh-chuyen-dung-clearway-glasspro-cong-thuc-khong-amoniac-an-toan-cho-kinh-va-guong-500ml",
  "nuoc-lau-kinh-chuyen-dung-clearway-glasspro-cong-thuc-khong-amoniac-an-toan-tang-kem-binh-xit-can-5l",
  "nuoc-rua-kinh-o-to-chuyen-dung-clearway-chong-bam-nuoc-sach-sau-an-toan-voi-can-gat-va-be-mat-kinh",
  "chai-xit-tay-rua-vet-o-kinh-logo-o-to-va-mang-dau-kinh-xit-lam-sach-sau-tiet-kiem-visionx-clean",
];

const bestsellers = bestsellerSlugs
  .map((slug) => products.find((p) => p.slug === slug))
  .filter(Boolean);

const newArrivals = newArrivalSlugs
  .map((slug) => products.find((p) => p.slug === slug))
  .filter(Boolean);
---

<Layout
  title="VKINNO - Chất Tẩy Rửa Sinh Học, Chăm Sóc Ô Tô & Vệ Sinh Điện Mặt Trời"
  description="Công ty TNHH Công nghệ Vĩnh Khang (VKINNO) sản xuất và phân phối chất tẩy cặn canxi Bossman, tẩy dầu mỡ nhà bếp, nước rửa kính ô tô ClearWay và dung dịch vệ sinh pin mặt trời Solar Shield."
>
  <div class="w-full flex flex-col">
    <!-- ==================== 1. HERO BANNER SLIDER ==================== -->
    <section class="relative w-full aspect-[2244/701] max-h-[560px] bg-[#0F1638] overflow-hidden" id="home-section-hero">
      <div class="w-full h-full relative" id="hero-slides-wrapper">
        <div class="hero-slide absolute inset-0 transition-opacity duration-700 opacity-100" data-index="0">
          <img
            alt="VKINNO - Giải pháp tẩy rửa sinh học cho gia đình Việt"
            class="w-full h-full object-cover"
            src="/uploads/banner-homepage-1.png"
            width="1600"
            height="500"
            fetchpriority="high"
          />
        </div>
        <div class="hero-slide absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none" data-index="1">
          <img
            alt="Chăm sóc kính ô tô ClearWay & VisionX Clean không Methanol"
            class="w-full h-full object-cover"
            src="/uploads/banner-homepage-2.png"
            width="1600"
            height="500"
            loading="lazy"
          />
        </div>
        <div class="hero-slide absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none" data-index="2">
          <img
            alt="Dung dịch vệ sinh tấm pin mặt trời Solar Shield Can 5L"
            class="w-full h-full object-cover"
            src="/uploads/banner-homepage-3.png"
            width="1600"
            height="500"
            loading="lazy"
          />
        </div>
      </div>

      <button
        aria-label="Ảnh bìa trước"
        class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 bg-black/45 hover:bg-[#FF8A15] hover:text-[#0F1638] text-white rounded-full w-11 h-11 flex items-center justify-center transition-all focus:outline-none cursor-pointer z-20"
        id="hero-prev"
        type="button"
      >
        <i class="fa-solid fa-chevron-left text-sm sm:text-base"></i>
      </button>

      <button
        aria-label="Ảnh bìa tiếp theo"
        class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 bg-black/45 hover:bg-[#FF8A15] hover:text-[#0F1638] text-white rounded-full w-11 h-11 flex items-center justify-center transition-all focus:outline-none cursor-pointer z-20"
        id="hero-next"
        type="button"
      >
        <i class="fa-solid fa-chevron-right text-sm sm:text-base"></i>
      </button>

      <div class="absolute bottom-2 sm:bottom-4 left-1/2 -translate-x-1/2 flex items-center space-x-1.5 bg-black/40 backdrop-blur-xs px-3 py-1.5 rounded-full z-20">
        <button aria-label="Chuyển tới ảnh 1" type="button" class="hero-dot w-3 h-3 rounded-full transition-all bg-[#FF8A15] scale-110 cursor-pointer" data-index="0"></button>
        <button aria-label="Chuyển tới ảnh 2" type="button" class="hero-dot w-3 h-3 rounded-full transition-all bg-white/80 hover:bg-white cursor-pointer" data-index="1"></button>
        <button aria-label="Chuyển tới ảnh 3" type="button" class="hero-dot w-3 h-3 rounded-full transition-all bg-white/80 hover:bg-white cursor-pointer" data-index="2"></button>
      </div>
    </section>

    <!-- ==================== 1B. BRAND H1 & COMBO FREESHIP BAR ==================== -->
    <section class="w-full bg-[#1E2B6B] text-white border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 py-6 sm:py-8 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-[#FF8A15] text-xs font-extrabold uppercase tracking-wider">
            <i class="fa-solid fa-flask"></i>
            <span>Kho trực tiếp Công ty TNHH Công nghệ Vĩnh Khang (VAT 8%)</span>
          </div>
          <h1 class="text-xl sm:text-2xl lg:text-3xl font-extrabold leading-snug font-montserrat text-white">
            Chất Tẩy Rửa Chuyên Dụng, Chăm Sóc Kính Xe &amp; Vệ Sinh Điện Mặt Trời VKINNO
          </h1>
          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
            Làm sạch đúng cơ chế hóa học an toàn bề mặt khuyến nghị: <strong>Combo Đôi Nhà Sạch 145.000 ₫</strong> (tiết kiệm 9.000 ₫) · <strong>Bộ 3 Toàn Gia 199.000 ₫ miễn phí vận chuyển toàn quốc</strong>.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
          <button
            type="button"
            id="btn-home-bundle-199k"
            data-cta="bundle-199k"
            class="min-h-[48px] px-5 py-3 rounded-xl bg-[#FF8A15] hover:bg-[#E57600] text-[#0F1638] font-extrabold text-xs sm:text-sm uppercase tracking-wide flex items-center justify-center gap-2 shadow-lg cursor-pointer transition-all"
          >
            <i class="fa-solid fa-gift"></i>
            <span>Mua Bộ 3 Toàn Gia 199.000 ₫ (Freeship)</span>
          </button>
          <a
            href="/giai-phap-gara"
            class="min-h-[48px] px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 border border-white/25 text-white font-bold text-xs sm:text-sm uppercase tracking-wide flex items-center justify-center gap-2 transition-all"
