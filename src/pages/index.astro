            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== 3. SẢN PHẨM BÁN CHẠY NHẤT ==================== -->
    <section class="w-full bg-[#F8FAFC] py-12 sm:py-16 border-t border-[#E2E8F0]" id="home-section-bestsellers">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-8">
        <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-4 gap-4">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0F172A] tracking-wider uppercase font-montserrat">
            Sản phẩm bán chạy tại kho
          </h2>
          <a class="text-xs sm:text-sm font-extrabold text-[#A84B00] hover:text-[#1E2B6B] uppercase tracking-wider flex items-center space-x-1.5 transition-colors shrink-0" href="/san-pham">
            <span>Xem tất cả 9 mã</span>
            <i class="fa-solid fa-arrow-right-long"></i>
          </a>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          {bestsellers.map((product) => (
            <ProductCard product={product!} />
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== 4. TRUST BADGES ==================== -->
    <section class="w-full max-w-7xl mx-auto px-4 sm:px-8 py-10 sm:py-12 border-t border-[#E2E8F0] bg-white" id="home-section-trustbadges">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex flex-col sm:flex-row items-center text-center sm:text-left space-y-3 sm:space-y-0 sm:space-x-4 p-4 rounded-xl bg-[#F8FAFC] border border-[#E2E8F0]">
          <div class="bg-[#FFF7ED] text-[#A84B00] text-2xl w-14 h-14 rounded-full flex items-center justify-center shrink-0">
            <i class="fa-solid fa-truck-fast"></i>
          </div>
          <div class="space-y-1">
            <h3 class="text-xs sm:text-sm font-extrabold text-[#0F172A] uppercase tracking-wide">
              Freeship Từ 199.000 ₫
            </h3>
            <p class="text-xs text-[#475569] font-medium leading-relaxed">
              Miễn phí giao toàn quốc đơn từ 199.000 ₫ (dưới 199.000 ₫ phí ship 25.000 ₫)
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center text-center sm:text-left space-y-3 sm:space-y-0 sm:space-x-4 p-4 rounded-xl bg-[#F8FAFC] border border-[#E2E8F0]">
          <div class="bg-[#EEF2FF] text-[#1E2B6B] text-2xl w-14 h-14 rounded-full flex items-center justify-center shrink-0">
            <i class="fa-solid fa-file-invoice"></i>
          </div>
          <div class="space-y-1">
            <h3 class="text-xs sm:text-sm font-extrabold text-[#0F172A] uppercase tracking-wide">
              Pháp Nhân TNHH &amp; VAT 8%
            </h3>
            <p class="text-xs text-[#475569] font-medium leading-relaxed">
              Giá công bố đã gồm VAT 8%, xuất hóa đơn điện tử &amp; SDS/MSDS cho doanh nghiệp
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center text-center sm:text-left space-y-3 sm:space-y-0 sm:space-x-4 p-4 rounded-xl bg-[#F8FAFC] border border-[#E2E8F0]">
          <div class="bg-[#ECFDF5] text-[#047857] text-2xl w-14 h-14 rounded-full flex items-center justify-center shrink-0">
            <i class="fa-solid fa-arrows-rotate"></i>
          </div>
          <div class="space-y-1">
            <h3 class="text-xs sm:text-sm font-extrabold text-[#0F172A] uppercase tracking-wide">
              Đồng Kiểm &amp; Đổi Trả 7 Ngày
            </h3>
            <p class="text-xs text-[#475569] font-medium leading-relaxed">
              Kiểm tra ngoại quan khi nhận hàng; đổi mới 1:1 nếu móp rò rỉ do vận chuyển
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center text-center sm:text-left space-y-3 sm:space-y-0 sm:space-x-4 p-4 rounded-xl bg-[#F8FAFC] border border-[#E2E8F0]">
          <div class="bg-[#FFF7ED] text-[#A84B00] text-2xl w-14 h-14 rounded-full flex items-center justify-center shrink-0">
            <i class="fa-solid fa-headset"></i>
          </div>
          <div class="space-y-1">
            <h3 class="text-xs sm:text-sm font-extrabold text-[#0F172A] uppercase tracking-wide">
              Tư Vấn Kỹ Thuật Kho
            </h3>
            <p class="text-xs text-[#475569] font-medium leading-relaxed">
              Gửi ảnh vết ố qua Zalo {SITE_CONFIG.hotlinePrimary} để tư vấn đúng loại hóa chất
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== 5. DÒNG CHĂM SÓC KÍNH & Ô TÔ ==================== -->
    <section class="w-full bg-[#F8FAFC] py-12 sm:py-16 border-t border-[#E2E8F0]" id="home-section-newarrivals">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-8">
        <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-4 gap-4">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0F172A] tracking-wider uppercase font-montserrat">
            Chăm sóc kính tòa nhà &amp; Ô tô chuyên dụng
          </h2>
          <a class="text-xs sm:text-sm font-extrabold text-[#A84B00] hover:text-[#1E2B6B] uppercase tracking-wider flex items-center space-x-1.5 transition-colors shrink-0" href="/san-pham">
            <span>Xem cửa hàng</span>
            <i class="fa-solid fa-arrow-right-long"></i>
          </a>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          {newArrivals.map((product) => (
            <ProductCard product={product!} />
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== 6. CẨM NANG VKINNO ==================== -->
    <section class="w-full max-w-7xl mx-auto px-4 sm:px-8 py-12 sm:py-16 bg-white border-t border-[#E2E8F0]" id="home-section-blogshowcase">
      <div class="space-y-8">
        <div class="flex flex-col items-center text-center space-y-2">
          <h2 class="text-xl sm:text-2xl font-extrabold text-[#0F172A] tracking-widest uppercase font-montserrat">
            CẨM NANG SỬ DỤNG HÓA CHẤT ĐÚNG CÁCH
          </h2>
          <div class="w-16 h-1 bg-[#FF8A15] rounded"></div>
          <p class="text-xs sm:text-sm text-[#475569] font-medium max-w-xl">
            Hướng dẫn thời gian ủ 5–15 phút, tỷ lệ pha loãng can 5L và lưu ý nhận biết bề mặt vật liệu trước khi vệ sinh
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {postsData.map((post) => (
            <a class="group space-y-4 flex flex-col justify-between bg-[#F8FAFC] p-4 rounded-2xl border border-[#E2E8F0] hover:shadow-md transition-all" href={`/cam-nang/${post.slug}`}>
              <div class="space-y-3">
                <div class="w-full aspect-[16/10] overflow-hidden rounded-xl bg-white relative">
                  <img
                    alt={post.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    src={post.image_url}
                    width="600"
                    height="375"
                  />
                </div>
                <div class="flex items-center text-[11px] font-bold text-[#475569] uppercase tracking-wider space-x-2">
                  <span><i class="fa-regular fa-calendar-days mr-1 text-[#A84B00]"></i> 04/07/2026</span>
                  <span>•</span>
                  <span>Cẩm nang kỹ thuật</span>
                </div>
                <h3 class="text-[#0F172A] font-extrabold text-sm sm:text-base line-clamp-2 group-hover:text-[#1E2B6B] transition-colors leading-snug">
                  {post.title}
                </h3>
                <p class="text-xs text-[#475569] font-medium leading-relaxed line-clamp-3">
                  {post.summary}
                </p>
              </div>
              <span class="text-xs font-extrabold text-[#A84B00] group-hover:text-[#1E2B6B] uppercase tracking-wider flex items-center space-x-1.5 transition-colors pt-2">
                <span>Đọc hướng dẫn</span>
                <i class="fa-solid fa-arrow-right-long"></i>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  const slides = document.querySelectorAll<HTMLElement>(".hero-slide");
  const dots = document.querySelectorAll<HTMLElement>(".hero-dot");
  const prevBtn = document.getElementById("hero-prev");
  const nextBtn = document.getElementById("hero-next");

  let currentIdx = 0;
  const totalSlides = slides.length;
  let interval: ReturnType<typeof setInterval> | null = null;

  function showSlide(index: number) {
    if (totalSlides === 0) return;
    currentIdx = (index + totalSlides) % totalSlides;

    slides.forEach((slide, i) => {
      if (i === currentIdx) {
        slide.classList.remove("opacity-0", "pointer-events-none");
        slide.classList.add("opacity-100");
      } else {
        slide.classList.remove("opacity-100");
        slide.classList.add("opacity-0", "pointer-events-none");
      }
    });

    dots.forEach((dot, i) => {
      if (i === currentIdx) {
        dot.className = "hero-dot w-3 h-3 rounded-full transition-all bg-[#FF8A15] scale-110 cursor-pointer";
      } else {
        dot.className = "hero-dot w-3 h-3 rounded-full transition-all bg-white/80 hover:bg-white cursor-pointer";
      }
    });
  }

  function startAutoplay() {
    stopAutoplay();
    interval = setInterval(() => {
      showSlide(currentIdx + 1);
    }, 5500);
  }

  function stopAutoplay() {
    if (interval) clearInterval(interval);
  }

  prevBtn?.addEventListener("click", () => {
    showSlide(currentIdx - 1);
    startAutoplay();
  });

  nextBtn?.addEventListener("click", () => {
    showSlide(currentIdx + 1);
    startAutoplay();
  });

  dots.forEach((dot, i) => {
    dot.addEventListener("click", () => {
      showSlide(i);
      startAutoplay();
    });
  });

