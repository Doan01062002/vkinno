---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import Icon from "../components/Icon.astro";
import { pageSeo } from "../data/seo";
import { products } from "../data/products";
import { SITE_CONFIG } from "../data/siteConfig";
import postsData from "../data/posts.json";

const bestsellerSlugs = [
  "combo-chai-xit-tay-can-canxi-500ml-va-chai-tay-dau-mo-an-toan-da-tay-cong-thuc-moi-sach-vuot-troi---combobossmanvkinno-1782568108",
  "chai-xit-tay-can-canxi-500ml-an-toan-cho-da-tay-dung-dich-tay-can-canxi-lam-sach-voi-sen-va-nha-tam",
  "tay-dau-mo-da-nang-cao-cap-vkinno-500ml-chuyen-dung-cho-bep-tu-bep-hong-ngoai-an-toan-be-mat-bep",
  "dung-dich-ve-sinh-tam-pin-mat-troi-solar-shield-dam-dac-giup-tang-hieu-suat-dien-tang-kem-binh-xit",
];

const newArrivalSlugs = [
  "nuoc-lau-kinh-clearway-glasspro-500ml-sach-nhanh-khong-vet-sang-bong-kinh-nha-van-phong",
  "nuoc-lau-kinh-lam-sach-cuc-sau-khong-de-lai-vet-mo-can-5l-tang-kem-binh-xit-clearway-glasspro",
  "nuoc-rua-kinh-o-to-chuyen-dung-clearway-chong-bam-nuoc-sach-sau-an-toan-voi-can-gat-va-be-mat-kinh",
  "chai-xit-tay-rua-vet-o-kinh-logo-o-to-va-mang-dau-kinh-xit-lam-sach-sau-tiet-kiem-visionx-clean",
];

const bestsellers = bestsellerSlugs
  .map((slug) => products.find((p) => p.slug === slug))
  .filter(Boolean);

const newArrivals = newArrivalSlugs
  .map((slug) => products.find((p) => p.slug === slug))
  .filter(Boolean);

const seo = pageSeo("/");

// Banner: mobile (< 640px) hiện chữ HTML + phần chai của chính ảnh banner; >= 640px giữ nguyên ảnh đầy đủ (spec V6).
const heroSlides = [
  {
    img: "/uploads/banner-homepage-1.png",
    alt: "Xịt tẩy dầu mỡ đa năng VKINNO 500ml",
    eyebrow: "VKINNO · 500ml",
    title: "Xịt tẩy dầu mỡ đa năng",
    sub: "Làm sạch dầu mỡ nhanh chóng, giữ sáng gian bếp mỗi ngày",
    href: "/san-pham/tay-dau-mo-da-nang-cao-cap-vkinno-500ml-chuyen-dung-cho-bep-tu-bep-hong-ngoai-an-toan-be-mat-bep",
    pos: "object-[88%_50%]",
  },
  {
    img: "/uploads/banner-homepage-2.png",
    alt: "Xịt tẩy cặn canxi Bossman 500ml",
    eyebrow: "VKINNO · 500ml",
    title: "Xịt tẩy cặn canxi Bossman",
    sub: "Đánh bay cặn vôi cứng đầu, giữ sáng bóng sen vòi & vách kính tắm",
    href: "/san-pham/chai-xit-tay-can-canxi-500ml-an-toan-cho-da-tay-dung-dich-tay-can-canxi-lam-sach-voi-sen-va-nha-tam",
    pos: "object-[83%_50%]",
  },
  {
    img: "/uploads/banner-homepage-3.png",
    alt: "Nước rửa kính ô tô ClearWay can 5L",
    eyebrow: "VKINNO · Can 5L",
    title: "Nước rửa kính ô tô ClearWay",
    sub: "Chống bám nước lá sen, trong suốt tầm nhìn vượt mưa bão",
    href: "/san-pham/nuoc-rua-kinh-o-to-chuyen-dung-clearway-chong-bam-nuoc-sach-sau-an-toan-voi-can-gat-va-be-mat-kinh",
    pos: "object-[84%_50%]",
  },
];
---

<Layout title={seo.title} description={seo.description}>
  <div class="w-full flex flex-col">
    <!-- ==================== 1. HERO BANNER SLIDER ==================== -->
    <section
      class="relative w-full h-[264px] sm:h-auto sm:aspect-[2244/701] max-h-[560px] bg-[#EEF4FF] sm:bg-[#0F1638] overflow-hidden touch-pan-y"
      id="home-section-hero"
      aria-roledescription="carousel"
      aria-label="Sản phẩm nổi bật"
    >
      <div class="w-full h-full relative" id="hero-slides-wrapper">
        {heroSlides.map((s, i) => (
          <div
            class={`hero-slide absolute inset-0 transition-opacity duration-700 ${i === 0 ? "opacity-100" : "opacity-0 pointer-events-none"}`}
            data-index={i}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} / ${heroSlides.length}: ${s.alt}`}
            aria-hidden={i === 0 ? undefined : "true"}
          >
            <img
              src={s.img}
              alt={s.alt}
              width="1600"
              height="500"
              class={`absolute top-0 right-0 h-full w-[44%] object-cover ${s.pos} sm:inset-0 sm:w-full sm:object-center`}
              fetchpriority={i === 0 ? "high" : undefined}
              loading={i === 0 ? undefined : "lazy"}
            />
            <div aria-hidden="true" class="sm:hidden absolute inset-y-0 left-[56%] w-8 bg-gradient-to-r from-[#EEF4FF] to-transparent"></div>
            <a
              href={s.href}
              tabindex={i === 0 ? 0 : -1}
              class="hero-link sm:hidden absolute inset-y-0 left-0 w-[56%] flex flex-col justify-center gap-1.5 pl-4 pr-2 pt-4 pb-12 bg-gradient-to-r from-[#EEF4FF] to-[#F2F6FF]"
            >
              <span class="text-xs font-bold uppercase tracking-wide text-[#A84B00]">{s.eyebrow}</span>
              <p class="font-display font-extrabold text-xl leading-[1.3] text-[#1E2B6B] text-balance">{s.title}</p>
              <p class="text-sm leading-[1.4] text-[#334155] line-clamp-3">{s.sub}</p>
              <span class="mt-1.5 self-start inline-flex items-center gap-1.5 min-h-11 px-4 rounded-xl bg-[#FF8A15] text-[#0F1638] text-sm font-extrabold">
                Xem sản phẩm <Icon name="arrow-right" class="text-base" />
              </span>
            </a>
          </div>
        ))}
      </div>

      <button
        aria-label="Ảnh bìa trước"
        class="hidden sm:flex absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 bg-black/45 hover:bg-[#FF8A15] hover:text-[#0F1638] text-white rounded-full w-11 h-11 items-center justify-center transition-colors cursor-pointer z-20"
        id="hero-prev"
        type="button"
      >
        <Icon name="chevron-left" class="text-base" />
      </button>

      <button
        aria-label="Ảnh bìa tiếp theo"
        class="hidden sm:flex absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 bg-black/45 hover:bg-[#FF8A15] hover:text-[#0F1638] text-white rounded-full w-11 h-11 items-center justify-center transition-colors cursor-pointer z-20"
        id="hero-next"
        type="button"
      >
        <Icon name="chevron-right" class="text-base" />
      </button>

      <div class="absolute z-20 left-2 bottom-0 flex sm:left-1/2 sm:-translate-x-1/2 sm:bottom-2 sm:bg-black/40 sm:rounded-full sm:px-1">
        {heroSlides.map((_s, i) => (
          <button
            type="button"
            class="hero-dot group size-11 flex items-center justify-center cursor-pointer"
            data-index={i}
            aria-label={`Chuyển tới ảnh ${i + 1}`}
            aria-current={i === 0 ? "true" : "false"}
          >
            <span class="block h-2 w-2 rounded-full bg-[#1E2B6B]/30 sm:bg-white/80 transition-[width,background-color] duration-200 group-aria-[current=true]:w-6 group-aria-[current=true]:bg-[#FF8A15]"></span>
          </button>
        ))}
      </div>
    </section>

    <!-- ==================== 1B. BRAND H1 & COMBO FREESHIP BAR ==================== -->
    <section class="w-full bg-[#1E2B6B] text-white border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 py-6 sm:py-8 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-[#FF8A15] text-xs font-extrabold uppercase tracking-wider">
            <Icon name="flask-conical" />
            <span>Kho trực tiếp Công ty TNHH Công nghệ Vĩnh Khang (VAT 8%)</span>
          </div>
          <h1 class="text-xl sm:text-2xl lg:text-3xl font-extrabold leading-snug font-montserrat text-white">
            Chất Tẩy Rửa Sinh Học Chuyên Dụng, Chăm Sóc Kính Xe &amp; Vệ Sinh Điện Mặt Trời VKINNO
          </h1>
          <p class="text-sm text-slate-200 leading-relaxed">
            Làm sạch đúng cơ chế hóa học an toàn bề mặt khuyến nghị: <strong>Combo Đôi Nhà Sạch 145.000 ₫</strong> (tiết kiệm 9.000 ₫) · <strong>Bộ 3 Toàn Gia 199.000 ₫ miễn phí vận chuyển toàn quốc</strong>.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
          <button
            type="button"
            id="btn-home-bundle-199k"
            data-cta="bundle-199k"
            class="min-h-[48px] px-5 py-3 rounded-xl bg-[#FF8A15] hover:bg-[#E57600] text-[#0F1638] font-extrabold text-xs sm:text-sm uppercase tracking-wide flex items-center justify-center gap-2 shadow-lg cursor-pointer transition-all"
          >
            <Icon name="gift" />
            <span>Mua Bộ 3 Toàn Gia 199.000 ₫ (Freeship)</span>
          </button>
          <a
            href="/giai-phap-gara"
            class="min-h-[48px] px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 border border-white/25 text-white font-bold text-xs sm:text-sm uppercase tracking-wide flex items-center justify-center gap-2 transition-all"
          >
            <Icon name="building-2" />
            <span>Báo giá sỉ Gara &amp; Solar</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== 2. FEATURED CATEGORIES ==================== -->
    <section class="w-full max-w-7xl mx-auto px-4 sm:px-8 pt-8 pb-12 sm:py-14 bg-white" id="home-section-categories">
      <div class="space-y-8">
        <div class="flex flex-col items-center text-center space-y-2">
          <h2 class="text-xl sm:text-2xl font-extrabold text-[#0F172A] tracking-wider uppercase font-montserrat">
            DANH MỤC GIẢI PHÁP CHỦ LỰC
          </h2>
          <div class="w-16 h-1 bg-[#FF8A15] rounded"></div>
          <p class="text-sm text-[#475569] font-medium max-w-lg">
            9 sản phẩm chuẩn hóa từ kho VKINNO Hoài Đức — đầy đủ hướng dẫn ủ hóa chất và cảnh báo bề mặt rõ ràng
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <a class="group relative block rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-[#E2E8F0]" href="/san-pham?category=1">
            <div class="w-full aspect-[4/3] overflow-hidden relative bg-[#F1F5F9]">
              <img
                alt="Tẩy Cặn Canxi, Nhà Bếp & Pin Mặt Trời"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                src="/images/blog/cat-tay-rua.jpg"
                width="480"
                height="360"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0F1638]/90 via-[#0F1638]/35 to-transparent"></div>
            </div>
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <h3 class="text-sm sm:text-base font-extrabold uppercase tracking-wide">
                Nhà Tắm, Nhà Bếp &amp; Solar
              </h3>
              <p class="text-sm text-slate-200 font-semibold mt-1">
                Bossman · Tẩy dầu mỡ · ClearWay · Solar Shield
              </p>
            </div>
          </a>

          <a class="group relative block rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-[#E2E8F0]" href="/san-pham?category=3">
            <div class="w-full aspect-[4/3] overflow-hidden relative bg-[#F1F5F9]">
              <img
                alt="Chăm Sóc Kính & Ngoại Thất Ô Tô"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                src="/images/blog/cat-oto.jpg"
                width="480"
                height="360"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0F1638]/90 via-[#0F1638]/35 to-transparent"></div>
            </div>
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <h3 class="text-sm sm:text-base font-extrabold uppercase tracking-wide">
                Chăm Sóc Ô Tô &amp; Gara
              </h3>
              <p class="text-sm text-slate-200 font-semibold mt-1">
                ClearWay Can 5L 0% Methanol · VisionX Clean
              </p>
            </div>
          </a>

          <a class="group relative block rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-[#E2E8F0]" href="/san-pham?category=2">
            <div class="w-full aspect-[4/3] overflow-hidden relative bg-[#F1F5F9]">
              <img
                alt="Bình xịt nhựa PET 500ml phun sương VKINNO"
                class="w-full h-full object-cover object-[50%_20%] origin-top scale-[1.34] group-hover:scale-[1.4] transition-transform duration-500"
                loading="lazy"
                src="/images/products/vk-bottle-spray-500ml.jpg"
                width="960"
                height="960"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0F1638]/90 via-[#0F1638]/35 to-transparent"></div>
            </div>
            <div class="absolute bottom-4 left-4 right-4 text-white">
              <h3 class="text-sm sm:text-base font-extrabold uppercase tracking-wide">
                Dụng Cụ &amp; Bình Xịt PET
              </h3>
              <p class="text-sm text-slate-200 font-semibold mt-1">
                Vỏ bình xịt kháng hóa chất 500ml sang chiết can 5L
              </p>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ==================== 3. SẢN PHẨM BÁN CHẠY NHẤT ==================== -->
    <section class="w-full bg-[#F8FAFC] py-12 sm:py-16 border-t border-[#E2E8F0]" id="home-section-bestsellers">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-8">
        <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-4 gap-4">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0F172A] tracking-wider uppercase font-montserrat">
            Sản phẩm bán chạy tại kho
          </h2>
          <a class="text-xs sm:text-sm font-extrabold text-[#A84B00] hover:text-[#1E2B6B] uppercase tracking-wider flex items-center gap-1.5 min-h-11 transition-colors shrink-0" href="/san-pham">
            <span>Xem tất cả 9 mã</span>
            <Icon name="move-right" />
          </a>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          {bestsellers.map((product) => (
            <ProductCard product={product!} />
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== 4. TRUST BADGES ==================== -->
    <section class="w-full max-w-7xl mx-auto px-4 sm:px-8 py-10 sm:py-12 border-t border-[#E2E8F0] bg-white" id="home-section-trustbadges">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="flex flex-col sm:flex-row items-center text-center sm:text-left space-y-3 sm:space-y-0 sm:space-x-4 p-4 rounded-xl bg-[#F8FAFC] border border-[#E2E8F0]">
          <div class="bg-[#FFF7ED] text-[#A84B00] text-2xl w-14 h-14 rounded-full flex items-center justify-center shrink-0">
            <Icon name="truck" />
          </div>
          <div class="space-y-1">
            <h3 class="text-xs sm:text-sm font-extrabold text-[#0F172A] uppercase tracking-wide">
              Freeship Từ 199.000 ₫
            </h3>
            <p class="text-sm text-[#475569] font-medium leading-relaxed">
              Miễn phí giao toàn quốc đơn từ 199.000 ₫ (dưới 199.000 ₫ phí ship 25.000 ₫)
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center text-center sm:text-left space-y-3 sm:space-y-0 sm:space-x-4 p-4 rounded-xl bg-[#F8FAFC] border border-[#E2E8F0]">
          <div class="bg-[#EEF2FF] text-[#1E2B6B] text-2xl w-14 h-14 rounded-full flex items-center justify-center shrink-0">
            <Icon name="file-text" />
          </div>
          <div class="space-y-1">
            <h3 class="text-xs sm:text-sm font-extrabold text-[#0F172A] uppercase tracking-wide">
              Pháp Nhân TNHH &amp; VAT 8%
            </h3>
            <p class="text-sm text-[#475569] font-medium leading-relaxed">
              Giá công bố đã gồm VAT 8%, xuất hóa đơn điện tử &amp; SDS/MSDS cho doanh nghiệp
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center text-center sm:text-left space-y-3 sm:space-y-0 sm:space-x-4 p-4 rounded-xl bg-[#F8FAFC] border border-[#E2E8F0]">
          <div class="bg-[#ECFDF5] text-[#047857] text-2xl w-14 h-14 rounded-full flex items-center justify-center shrink-0">
            <Icon name="refresh-cw" />
          </div>
          <div class="space-y-1">
            <h3 class="text-xs sm:text-sm font-extrabold text-[#0F172A] uppercase tracking-wide">
              Đồng Kiểm &amp; Đổi Trả 7 Ngày
            </h3>
            <p class="text-sm text-[#475569] font-medium leading-relaxed">
              Kiểm tra ngoại quan khi nhận hàng; đổi mới 1:1 nếu móp rò rỉ do vận chuyển
            </p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center text-center sm:text-left space-y-3 sm:space-y-0 sm:space-x-4 p-4 rounded-xl bg-[#F8FAFC] border border-[#E2E8F0]">
          <div class="bg-[#FFF7ED] text-[#A84B00] text-2xl w-14 h-14 rounded-full flex items-center justify-center shrink-0">
            <Icon name="headset" />
          </div>
          <div class="space-y-1">
            <h3 class="text-xs sm:text-sm font-extrabold text-[#0F172A] uppercase tracking-wide">
              Tư Vấn Kỹ Thuật Kho
            </h3>
            <p class="text-sm text-[#475569] font-medium leading-relaxed">
              Gửi ảnh vết ố qua Zalo {SITE_CONFIG.hotlinePrimary} để tư vấn đúng loại hóa chất
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== 5. DÒNG CHĂM SÓC KÍNH & Ô TÔ ==================== -->
    <section class="w-full bg-[#F8FAFC] py-12 sm:py-16 border-t border-[#E2E8F0]" id="home-section-newarrivals">
      <div class="max-w-7xl mx-auto px-4 sm:px-8 space-y-8">
        <div class="flex items-center justify-between border-b border-[#E2E8F0] pb-4 gap-4">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0F172A] tracking-wider uppercase font-montserrat">
            Chăm sóc kính tòa nhà &amp; Ô tô chuyên dụng
          </h2>
          <a class="text-xs sm:text-sm font-extrabold text-[#A84B00] hover:text-[#1E2B6B] uppercase tracking-wider flex items-center gap-1.5 min-h-11 transition-colors shrink-0" href="/san-pham">
            <span>Xem cửa hàng</span>
            <Icon name="move-right" />
          </a>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
          {newArrivals.map((product) => (
            <ProductCard product={product!} />
          ))}
        </div>
      </div>
    </section>

    <!-- ==================== 6. CẨM NANG VKINNO ==================== -->
    <section class="w-full max-w-7xl mx-auto px-4 sm:px-8 py-12 sm:py-16 bg-white border-t border-[#E2E8F0]" id="home-section-blogshowcase">
      <div class="space-y-8">
        <div class="flex flex-col items-center text-center space-y-2">
          <h2 class="text-xl sm:text-2xl font-extrabold text-[#0F172A] tracking-widest uppercase font-montserrat">
            CẨM NANG SỬ DỤNG HÓA CHẤT ĐÚNG CÁCH
          </h2>
          <div class="w-16 h-1 bg-[#FF8A15] rounded"></div>
          <p class="text-sm text-[#475569] font-medium max-w-xl">
            Hướng dẫn thời gian ủ 5–15 phút, tỷ lệ pha loãng can 5L và lưu ý nhận biết bề mặt vật liệu trước khi vệ sinh
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {postsData.map((post) => (
            <a class="group space-y-4 flex flex-col justify-between bg-[#F8FAFC] p-4 rounded-2xl border border-[#E2E8F0] hover:shadow-md transition-all" href={`/cam-nang/${post.slug}`}>
              <div class="space-y-3">
                <div class="w-full aspect-[16/10] overflow-hidden rounded-xl bg-white relative">
                  <img
                    alt={post.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    src={post.image_url}
                    width="600"
                    height="375"
                  />
                </div>
                <div class="flex items-center text-xs font-bold text-[#475569] uppercase tracking-wider gap-2">
                  <span class="inline-flex items-center gap-1"><Icon name="calendar-days" class="text-[#A84B00]" /> 04/07/2026</span>
                  <span>•</span>
                  <span>Cẩm nang kỹ thuật</span>
                </div>
                <h3 class="text-[#0F172A] font-extrabold text-sm sm:text-base line-clamp-2 group-hover:text-[#1E2B6B] transition-colors leading-snug">
                  {post.title}
                </h3>
                <p class="text-sm text-[#475569] font-medium leading-relaxed line-clamp-3">
                  {post.summary}
                </p>
              </div>
              <span class="text-xs font-extrabold text-[#A84B00] group-hover:text-[#1E2B6B] uppercase tracking-wider flex items-center gap-1.5 transition-colors pt-2">
                <span>Đọc hướng dẫn</span>
                <Icon name="move-right" />
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  const slides = document.querySelectorAll<HTMLElement>(".hero-slide");
  const dots = document.querySelectorAll<HTMLElement>(".hero-dot");
  const prevBtn = document.getElementById("hero-prev");
  const nextBtn = document.getElementById("hero-next");
  const heroWrap = document.getElementById("home-section-hero");

  let currentIdx = 0;
  const totalSlides = slides.length;
  let interval: ReturnType<typeof setInterval> | null = null;
  // Tự chạy > 5 giây phải dừng được: dừng hẳn khi người dùng chạm/vuốt, đưa focus vào, hoặc bật giảm chuyển động.
  let autoplayStopped = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function showSlide(index: number) {
    if (totalSlides === 0) return;
    currentIdx = (index + totalSlides) % totalSlides;

    slides.forEach((slide, i) => {
      const active = i === currentIdx;
      slide.classList.toggle("opacity-100", active);
      slide.classList.toggle("opacity-0", !active);
      slide.classList.toggle("pointer-events-none", !active);
      if (active) slide.removeAttribute("aria-hidden");
      else slide.setAttribute("aria-hidden", "true");
      slide.querySelector(".hero-link")?.setAttribute("tabindex", active ? "0" : "-1");
    });

    dots.forEach((dot, i) => {
      dot.setAttribute("aria-current", i === currentIdx ? "true" : "false");
    });
  }

  function stopAutoplay() {
    if (interval) clearInterval(interval);
    interval = null;
  }

  function startAutoplay() {
    stopAutoplay();
    if (autoplayStopped) return;
    interval = setInterval(() => {
      showSlide(currentIdx + 1);
    }, 5500);
  }

  function stopForGood() {
    autoplayStopped = true;
    stopAutoplay();
  }

  prevBtn?.addEventListener("click", () => {
    showSlide(currentIdx - 1);
    startAutoplay();
  });

  nextBtn?.addEventListener("click", () => {
    showSlide(currentIdx + 1);
    startAutoplay();
  });

  dots.forEach((dot, i) => {
    dot.addEventListener("click", () => {
      showSlide(i);
      startAutoplay();
    });
  });

  // Vuốt ngang trên mobile: lệch > 40px thì đổi ảnh
  let touchX0: number | null = null;
  heroWrap?.addEventListener(
    "touchstart",
    (ev) => {
      stopForGood();
      touchX0 = ev.touches[0]?.clientX ?? null;
    },
    { passive: true }
  );
  heroWrap?.addEventListener(
    "touchend",
    (ev) => {
      if (touchX0 === null) return;
      const dx = (ev.changedTouches[0]?.clientX ?? touchX0) - touchX0;
      touchX0 = null;
      if (Math.abs(dx) > 40) showSlide(currentIdx + (dx < 0 ? 1 : -1));
    },
    { passive: true }
  );
  heroWrap?.addEventListener("focusin", stopForGood);
  heroWrap?.addEventListener("mouseenter", stopAutoplay);
  heroWrap?.addEventListener("mouseleave", startAutoplay);
  startAutoplay();

  // 1-Tap Add Bộ 3 Toàn Gia 199.000đ (Combo 145k + ClearWay 500ml 45k -> wait: 145k + 45k = 190k, OR Bossman 69k + Tẩy dầu mỡ 85k + ClearWay 45k = 199k!)
  document.getElementById("btn-home-bundle-199k")?.addEventListener("click", () => {
    const addFn = (window as any).vkinnoAddToCart;
    if (typeof addFn === "function") {
      addFn(
        "Chai Xịt Tẩy Cặn Canxi Bossman 500ml — Sạch Vách Kính & Vòi Sen Inox",
        69000,
        "/images/products/vk-bossman-descaler-500ml.jpg",
        "chai-xit-tay-can-canxi-500ml-an-toan-cho-da-tay-dung-dich-tay-can-canxi-lam-sach-voi-sen-va-nha-tam",
        1,
        "VK-BOSSMAN-DESCALER-500ML"
      );
      addFn(
        "Chai Xịt Tẩy Dầu Mỡ Đa Năng VKINNO 500ml — Chuyên Dụng Cho Bếp Từ & Máy Hút Mùi",
        85000,
        "/images/products/vk-degreaser-500ml.jpg",
        "tay-dau-mo-da-nang-cao-cap-vkinno-500ml-chuyen-dung-cho-bep-tu-bep-hong-ngoai-an-toan-be-mat-bep",
        1,
        "VK-DEGREASER-500ML"
      );
      addFn(
        "Nước Lau Kính Chuyên Dụng ClearWay GlassPro 500ml — Không Amoniac, Trong Suốt Không Vệt",
        45000,
        "/images/products/vk-clearway-glasspro-500ml.jpg",
        "nuoc-lau-kinh-clearway-glasspro-500ml-sach-nhanh-khong-vet-sang-bong-kinh-nha-van-phong",
        1,
        "VK-CLEARWAY-GLASSPRO-500ML"
      );
      window.location.href = "/thanh-toan";
    }
  });
</script>
